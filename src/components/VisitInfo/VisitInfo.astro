---
import { BUSINESS } from "@data/client";
---

<section class="visit">
	<div class="visit-inner">
		<div class="visit-block">
			<p class="sec-kicker">Visítanos</p>
			<h2 class="sec-title">Horario y <span class="hl">ubicación</span></h2>
			<p class="visit-hours">
				{BUSINESS.hours.open}
				<br />
				{BUSINESS.hours.closed}
			</p>
		</div>
		<div class="visit-block">
			<p class="visit-address">
				{BUSINESS.address.lineOne}
				<br />
				{BUSINESS.address.lineTwo}
				<br />
				{BUSINESS.address.lineThree}
			</p>
			<div class="visit-actions">
				<a href={BUSINESS.address.mapLink} target="_blank" rel="noopener" class="cs-button-solid">
					Cómo llegar
				</a>
				<a href={BUSINESS.whatsapp} target="_blank" rel="noopener" class="cs-button-transparent">
					WhatsApp
				</a>
			</div>
		</div>
	</div>

	<div class="visit-map">
		<iframe
			title="Mapa — Cafetería La Movie"
			src="https://www.google.com/maps?q=18.5152884,-69.8661444&t=k&z=18&output=embed"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
			allowfullscreen
		></iframe>
	</div>
</section>

<style lang="less">
	.visit {
		padding: var(--sectionPadding);
	}

	.visit-map {
		max-width: (1100/16rem);
		margin: (24/16rem) auto 0;
		border: 1px solid #232323;
		border-radius: (20/16rem);
		overflow: hidden;

		iframe {
			width: 100%;
			height: (320/16rem);
			border: 0;
			display: block;
		}
	}

	.visit-inner {
		max-width: (1100/16rem);
		margin: auto;
		background-color: #141414;
		border: 1px solid #232323;
		border-radius: (20/16rem);
		padding: (40/16rem) (24/16rem);
		display: flex;
		flex-direction: column;
		gap: (32/16rem);
	}

	.visit-block .sec-title {
		margin-bottom: (12/16rem);
	}

	.visit-hours {
		font-size: (17/16rem);
		line-height: 1.7em;
		color: #d4d4d4;
		margin-bottom: 0;
	}

	.visit-address {
		font-size: (17/16rem);
		line-height: 1.7em;
		color: #fff;
		margin-bottom: (24/16rem);
	}

	.visit-actions {
		display: flex;
		flex-wrap: wrap;
		gap: (12/16rem);
	}

	@media only screen and (min-width: 64rem) {
		.visit-inner {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			padding: (48/16rem) (48/16rem);
		}

		.visit-block:last-child {
			text-align: right;
		}

		.visit-actions {
			justify-content: flex-end;
		}
	}
</style>
