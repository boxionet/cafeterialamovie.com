---
import { BUSINESS } from "@data/client";
import deliveryBike from "@assets/images/delivery-bike.svg";

// Same prefilled message as the Delivery card in "Pide a tu manera".
const deliveryHref = `${BUSINESS.whatsapp}?text=${encodeURIComponent("Hola! Quiero hacer un pedido para delivery.")}`;
---

<section class="delivery" data-delivery>
	<div class="delivery-inner">
		<div class="delivery-msg">
			<div class="delivery-text">
				<p class="sec-kicker">Delivery</p>
				<h2 class="sec-title">¡Hacemos <span class="hl">delivery!</span></h2>
				<p class="delivery-sub">Pide por WhatsApp y te lo llevamos a tu casa.</p>
				<a href={deliveryHref} target="_blank" rel="noopener" class="delivery-btn">
					Pedir delivery
				</a>
			</div>
			<svg class="delivery-line" viewBox="0 0 360 30" aria-hidden="true">
				<path
					d="M 5 20 C 110 30 240 18 350 12"
					fill="none"
					stroke="#fdcc00"
					stroke-width="3.5"
					stroke-linecap="round"
				/>
				<circle cx="350" cy="12" r="6" fill="#fdcc00" />
			</svg>
		</div>
		<div class="delivery-bike">
			<img
				src={deliveryBike.src}
				alt="Repartidor de Cafetería La Movie en motocicleta CG con caja de delivery"
				width="975"
				height="520"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="delivery-road" aria-hidden="true">
			<div class="delivery-road-dashes"></div>
		</div>
	</div>
</section>

<script>
	const section = document.querySelector("[data-delivery]");
	if (section) {
		// Progressive enhancement: without JS (or with reduced motion) the
		// section renders in its final state. With JS, the animation only
		// runs once the section scrolls into view.
		section.classList.add("dlv-js");
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						section.classList.add("play");
						io.disconnect();
					}
				}
			},
			{ threshold: 0.25 },
		);
		io.observe(section);
	}
</script>

<style lang="less">
	.delivery {
		overflow: hidden;
		background-color: #000;
	}

	.delivery-inner {
		max-width: (1280/16rem);
		margin: auto;
		padding: (64/16rem) (16/16rem) 0;
		display: grid;
		grid-template-columns: 1fr;
	}

	.delivery-msg {
		position: relative;
		z-index: 2;
		align-self: center;
		padding-bottom: (32/16rem);

		.sec-title {
			margin-bottom: (14/16rem);
		}
	}

	.delivery-sub {
		font-size: clamp(1rem, 2.2cqw, 1.22rem);
		font-weight: 700;
		color: #cfc8b8;
		line-height: 1.55em;
		margin: 0 0 (24/16rem);
	}

	// Yellow pill button — same as the order-ways buttons.
	.delivery-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: (17/16rem);
		line-height: 1em;
		color: #141414;
		background-color: var(--secondary);
		border-radius: 999px;
		padding: (15/16rem) (26/16rem);
		min-height: (50/16rem);
		text-decoration: none;
		transition: background-color 0.3s;

		&:hover {
			background-color: #e6b800;
		}
	}

	.delivery-line {
		display: block;
		width: min(100%, (360/16rem));
		height: auto;
		margin-top: (26/16rem);
	}

	.delivery-bike {
		position: relative;
		z-index: 1;
		align-self: end;

		img {
			display: block;
			width: 100%;
			height: auto;
		}
	}

	.delivery-road {
		grid-column: 1 / -1;
		height: (26/16rem);
		background-color: #161616;
		border-top: 3px solid #2a2a2a;
	}

	.delivery-road-dashes {
		height: 4px;
		margin-top: (9/16rem);
		background-image: repeating-linear-gradient(
			90deg,
			#e8e8e8 0 46px,
			transparent 46px 120px
		);
		opacity: 0.45;
	}

	@media only screen and (min-width: 64rem) {
		.delivery-inner {
			grid-template-columns: 5fr 7fr;
			column-gap: (48/16rem);
		}
	}

	/*-- -------------------------- -->
	<---   Ride-in animation      -->
	<--- -------------------------- -*/
	// Hidden states only apply when JS is on (the script adds .dlv-js);
	// without JS the section renders in its final state.
	.delivery.dlv-js {
		.delivery-bike {
			transform: translateX(-100vw);
			opacity: 0;
		}

		.delivery-text {
			opacity: 0;
			transform: scale(0.85);
			transform-origin: left center;
		}

		.delivery-line path {
			stroke-dasharray: 400;
			stroke-dashoffset: 400;
		}

		.delivery-line circle {
			opacity: 0;
		}

		&.play {
			.delivery-bike {
				animation: dlv-ride 4.2s cubic-bezier(0.25, 0.7, 0.3, 1) forwards;
			}

			.delivery-line path {
				animation: dlv-line 1s ease-out 4.4s forwards;
			}

			.delivery-line circle {
				animation: dlv-dot 0.3s ease 5.4s forwards;
			}

			.delivery-text {
				animation: dlv-msg 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) 5.4s forwards;
			}
		}
	}

	@keyframes dlv-ride {
		from {
			transform: translateX(-100vw);
			opacity: 0;
		}
		6% {
			opacity: 1;
		}
		to {
			transform: translateX(0);
			opacity: 1;
		}
	}

	@keyframes dlv-line {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes dlv-dot {
		to {
			opacity: 1;
		}
	}

	@keyframes dlv-msg {
		from {
			opacity: 0;
			transform: scale(0.85);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.delivery.dlv-js {
			.delivery-bike,
			.delivery-text {
				opacity: 1;
				transform: none;
				animation: none;
			}

			.delivery-line path {
				stroke-dashoffset: 0;
			}

			.delivery-line circle {
				opacity: 1;
			}
		}
	}
</style>
