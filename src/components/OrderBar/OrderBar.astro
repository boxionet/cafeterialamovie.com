---
import { BUSINESS } from "@data/client";
---

<div id="order-bar" class="order-bar" data-order-bar hidden>
	<div class="order-bar-main">
		<button
			type="button"
			class="order-toggle"
			data-order-toggle
			aria-expanded="false"
			aria-controls="order-panel"
		>
			<span class="order-count" data-order-count>0</span>
			<span class="order-summary" data-order-summary>Tu pedido · RD$0</span>
			<span class="order-chevron" aria-hidden="true">▲</span>
		</button>
		<a
			class="order-send"
			data-order-send
			href={BUSINESS.whatsapp}
			target="_blank"
			rel="noopener"
		>
			Enviar por WhatsApp
		</a>
	</div>

	<div id="order-panel" class="order-panel" data-order-panel hidden>
		<ul class="order-lines" data-order-lines></ul>
		<div class="order-panel-foot">
			<span>
				Total: <strong data-order-total>RD$0</strong>
			</span>
			<button type="button" class="order-clear" data-order-clear>Vaciar pedido</button>
		</div>
	</div>
</div>

<div id="order-toast" class="order-toast" role="status" data-order-toast hidden></div>

<style lang="less">
	.order-bar {
		width: min(92%, (640/16rem));
		background-color: #141414;
		border: 1px solid #2a2a2a;
		border-radius: (16/16rem);
		box-shadow: 0 (16/16rem) (40/16rem) rgba(0, 0, 0, 0.6);
		position: fixed;
		bottom: (16/16rem);
		left: 50%;
		transform: translateX(-50%);
		z-index: 9000;
		overflow: hidden;
	}

	.order-bar-main {
		display: flex;
		align-items: center;
		gap: (8/16rem);
		padding: (10/16rem) (10/16rem) (10/16rem) (16/16rem);
	}

	.order-toggle {
		font-family: var(--font-primary);
		font-size: (15/16rem);
		font-weight: 700;
		color: #fff;
		background: transparent;
		border: none;
		display: flex;
		align-items: center;
		gap: (10/16rem);
		flex: 1;
		min-width: 0;
		cursor: pointer;
		text-align: left;
	}

	.order-count {
		font-family: var(--font-display);
		font-size: (18/16rem);
		line-height: 1em;
		color: #000;
		background-color: var(--secondary);
		border-radius: 50%;
		width: (32/16rem);
		height: (32/16rem);
		display: flex;
		justify-content: center;
		align-items: center;
		flex: none;
	}

	.order-summary {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.order-chevron {
		font-size: (11/16rem);
		color: var(--secondary);
		transition: transform 0.3s;
	}

	.order-toggle[aria-expanded="true"] .order-chevron {
		transform: rotate(180deg);
	}

	.order-send {
		font-size: (14/16rem);
		font-weight: 800;
		line-height: 1.2em;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
		color: #fff;
		background-color: var(--primary);
		border-radius: 999px;
		padding: (11/16rem) (16/16rem);
		flex: none;
	}

	.order-panel {
		border-top: 1px solid #2a2a2a;
		max-height: (280/16rem);
		overflow-y: auto;
		padding: (12/16rem) (16/16rem);
	}

	.order-lines {
		list-style: none;
		margin: 0 0 (12/16rem);
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: (10/16rem);
	}

	.order-lines li {
		font-size: (14/16rem);
		line-height: 1.4em;
		color: #d4d4d4;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: (12/16rem);
	}

	.order-lines .order-line-remove {
		font-size: (13/16rem);
		font-weight: 700;
		color: #a8a8a8;
		background: transparent;
		border: 1px solid #333;
		border-radius: 999px;
		padding: (4/16rem) (10/16rem);
		cursor: pointer;
		flex: none;

		&:hover {
			color: #fff;
			border-color: var(--primary);
		}
	}

	.order-panel-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: (15/16rem);
		color: #fff;
	}

	.order-panel-foot strong {
		color: var(--secondary);
	}

	.order-clear {
		font-family: var(--font-primary);
		font-size: (13/16rem);
		font-weight: 700;
		color: #a8a8a8;
		background: transparent;
		border: none;
		cursor: pointer;

		&:hover {
			color: #fff;
		}
	}

	.order-toast {
		font-size: (14/16rem);
		font-weight: 700;
		text-align: center;
		color: #000;
		background-color: var(--secondary);
		border-radius: 999px;
		box-shadow: 0 (8/16rem) (24/16rem) rgba(0, 0, 0, 0.5);
		padding: (10/16rem) (20/16rem);
		position: fixed;
		bottom: (88/16rem);
		left: 50%;
		transform: translateX(-50%);
		z-index: 9500;
		white-space: nowrap;
		max-width: 92%;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
