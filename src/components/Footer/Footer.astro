---
import { BUSINESS } from "@data/client";
import navData from "@data/navData.json";
import { getCurrentYear } from "@js/utils";
import { getSiteContext } from "@js/getSiteContext";
import { getLocalizedRoute } from "@js/routes";
import logo from "@assets/svgs/logo.svg";

const { locale, content } = await getSiteContext(Astro.url);

const currentYear = getCurrentYear();
---

<footer id="footer">
	<div class="container">
		<section class="left-section">
			<a class="logo" href={getLocalizedRoute(locale, "/")} aria-label={content.common.backToHome}>
				<img src={logo.src} alt="Cafetería La Movie — La Movie del Sabor" />
			</a>

			<p>{content.common.footer.p}</p>

			<a class="cs-button-solid" href={BUSINESS.whatsapp} target="_blank" rel="noopener">
				Pedir por WhatsApp
			</a>
		</section>

		<section class="right-section">
			<div class="lists">
				<ul>
					<li>
						<h2>{content.common.footer.information}</h2>
					</li>

					{navData.map((entry) => {
						const entryUrl = entry.urls?.[locale] ?? entry.urls?.es;
						const entryLabel = entry.label?.[locale] ?? entry.label?.es ?? entry.key;

						if (!entryUrl) return null;

						return (
							<li>
								<a href={getLocalizedRoute(locale, entryUrl)}>{entryLabel}</a>
							</li>
						);
					})}
				</ul>

				<ul>
					<li>
						<h2>{content.common.footer.contact}</h2>
					</li>

					<li>
						<a href={BUSINESS.whatsapp} target="_blank" rel="noopener">
							WhatsApp: {BUSINESS.phoneFormatted}
						</a>
					</li>

					<li>
						<a href={BUSINESS.address.mapLink} target="_blank" rel="noopener">
							{BUSINESS.address.lineOne}
							<br />
							{BUSINESS.address.lineTwo}
							<br />
							{BUSINESS.address.lineThree}
						</a>
					</li>

					<li>{BUSINESS.hours.short}</li>
					<li>{BUSINESS.hours.closed}</li>
				</ul>
			</div>
		</section>
	</div>

	<section class="credit">
		<span>
			{content.common.footer.credit} {currentYear} · Santo Domingo Este, República Dominicana
		</span>
		<span class="credit-boxionet">
			Sitio web creado y mantenido por{" "}
			<a href="https://boxionet.com" target="_blank" rel="noopener">
				Boxionet
			</a>
		</span>
	</section>
</footer>

<style lang="less">
	/* Mobile */
	@media only screen and (min-width: 0em) {
		#footer {
			font-size: ~"min(4vw, 1.2em)";
			padding: (64/16rem) 0 (20/16rem);
			background: #000;
			border-top: 1px solid #1f1f1f;

			.left-section {
				text-align: center;
				margin: auto;
				margin-bottom: (50/16rem);
				.logo {
					text-align: center;
					width: auto;
					height: (88/16em);
					margin: auto;
					margin-bottom: (24/16em);
					display: inline-block;

					img {
						width: auto;
						height: 100%;
						display: block;
					}
				}

				p {
					font-size: (14/16rem);
					line-height: 27/14;
					text-align: center;
					width: 100%;
					max-width: (307/14rem);
					margin: auto;
					margin-bottom: (24/16rem);
					color: #d4d4d4;
					opacity: 0.9;
				}

				.cs-button-solid {
					height: auto;
					line-height: 1.2em;
					padding: (14/16rem) (24/16rem);
				}
			}

			.right-section {
				width: 96%;
				max-width: (407/16rem);
				margin: auto;
				.lists {
					width: 96%;
					max-width: (307/16rem);
					margin: auto;
					display: flex;
					justify-content: space-between;
					flex-wrap: wrap;
					ul {
						margin-top: 0;
						margin-bottom: 0;
						padding: 0;

						&:nth-of-type(2) {
							margin-top: (50/16rem);
							li {
								margin-bottom: (16/16rem);
								display: flex;
								justify-content: flex-start;
								align-items: center;

								&:last-of-type {
									margin-bottom: 0;
								}
							}
						}

						li {
							font-size: (18/16rem);
							list-style: none;
							margin-bottom: (12/16rem);
							color: #fff;
							opacity: 0.9;

							a {
								line-height: 21/18em;
								text-decoration: none;
								color: #fff;
								transition: color 0.3s;
								&:hover {
									color: var(--primary);
								}
							}
						}
						h2 {
							font-size: (18/16rem);
							font-weight: bold;
							line-height: 21/18em;
							text-transform: uppercase;
							margin-bottom: (37/16rem);
							color: #fff;
							position: relative;

							&:before {
								content: "";
								width: (97/16rem);
								height: (2/16rem);
								background: var(--primary);
								opacity: 1;
								display: block;
								position: absolute;
								bottom: (-16/16rem);
								left: 0;
							}
						}
					}
				}
			}

			.credit {
				font-size: (14/16rem);
				line-height: (24/16rem);
				text-align: center;
				width: 96%;
				margin: auto;
				margin-top: (64/16rem);
				color: #a8a8a8;

				.credit-boxionet {
					display: block;
					margin-top: (8/16rem);

					a {
						color: var(--secondary);
						text-decoration: none;

						&:hover {
							text-decoration: underline;
						}
					}
				}
			}
		}
	}

	/* Small Desktop */
	@media only screen and (min-width: 64em) {
		#footer {
			font-size: ~"min(1.2vw, 1em)";
			.container {
				width: 96%;
				max-width: (1320/16rem);
				margin: auto;
				padding: 0;
				display: flex;
				flex-direction: row;
				justify-content: space-between;
				flex-wrap: nowrap;
			}

			.left-section {
				text-align: left;
				width: (409/16rem);
				margin: 0;

				.logo {
					text-align: left;
					height: (104/16rem);
					margin-left: 0;
				}

				p {
					text-align: left;
					margin-left: 0;
				}
			}

			.right-section {
				width: auto;
				max-width: none;
				margin: 0;
				.lists {
					width: auto;
					max-width: (769/16rem);
					max-width: initial;
					margin: 0;
					justify-content: flex-start;
					gap: (64/16rem);

					ul {
						&:nth-of-type(2) {
							margin-top: 0;

							li:first-of-type {
								margin-bottom: 0;
							}
						}

						li {
							a {
								position: relative;

								&:before {
									content: "";
									width: 0%;
									height: (2/16rem);
									background: var(--primary);
									opacity: 1;
									display: block;
									position: absolute;
									bottom: (-3/16rem);
									left: 0;
									transition: width 0.3s;
								}

								&:hover {
									&:before {
										width: 100%;
									}
								}
							}
						}
					}
				}
			}

			.credit {
				margin-top: (64/16rem);
			}
		}
	}
</style>
