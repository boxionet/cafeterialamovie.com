---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { BUSINESS } from "@data/client";
import { OG, SITE } from "@data/siteConfig";
import { getLocalBusinessSchema } from "@js/localBusinessSchema.js";

interface Props {
	title?: string;
	description?: string;
	heroImage?: ImageMetadata;
	noindex?: boolean;
	locale: string;
	currentHreflang: string;
	ogLocale: string;
	alternates?: {
		hreflang: string;
		href: string;
	}[];
}

const {
	title = SITE.title,
	description = SITE.description,
	heroImage,
	noindex = false,
	locale,
	currentHreflang,
	ogLocale,
	alternates = [],
} = Astro.props;

const localBusinessSchema = getLocalBusinessSchema(Astro.url.origin, locale);
const canonical = Astro.url.href;
const [defaultAlternate] = alternates;

// Page titles already carry the business name (e.g. "Menú — Cafetería La
// Movie"), so only append it when it is missing — never repeat it, and
// never tack the city on again. The home title leads with the business,
// not with dish names.
const pageTitle = title.includes(BUSINESS.name) ? title : `${title} | ${BUSINESS.name}`;

const ogType = "website";

// Social sharing uses this page's own title and description, not the
// site-wide fallback — so a shared dish link shows the dish.
const ogTitle = pageTitle;
const ogDescription = description;

let socialImage: string;

if (heroImage) {
	const optimizedImage = await getImage({
		src: heroImage,
		width: 1200,
		height: 630,
		format: "jpeg",
	});
	socialImage = Astro.url.origin + optimizedImage.src;
} else {
	// Default social image (static file in public/)
	socialImage = Astro.url.origin + OG.image;
}
---

<!-- Standard Meta Tags -->
<meta charset="utf-8" />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="web_author" content={SITE.author} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Stop iOS Safari from auto-linking phone numbers in blue with an
		underline (it restyles bare numbers itself); numbers that should
		dial are explicit tel: links instead. -->
		<meta name="format-detection" content="telephone=no" />

<meta http-equiv="X-UA-Compatible" content="ie=edge" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- LocalBusiness Schema (on ALL pages) - customize your JSON-LD structured data:
     https://developers.google.com/search/docs/advanced/structured-data/intro-structured-data  -->
<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(localBusinessSchema)}
></script>
<!-- Allow additional schemas from child layouts (e.g., BlogPosting for blog posts) -->
<slot name="schema" />

<!-- Page Title -->
<title>{pageTitle}</title>

<!-- Hreflang alternate links for SEO -->
{alternates.map(({ hreflang, href }) => (
	<link rel="alternate" hreflang={hreflang} href={href} />
))}

{defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}

<!-- Open Graph / Facebook -->
<meta property="og:locale" content={ogLocale} />
{alternates
	.filter((a) => a.hreflang !== currentHreflang)
	.map((a) => (
		<meta property="og:locale:alternate" content={a.hreflang.replace("-", "_")} />
	))}
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={socialImage} />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
<meta content="image/jpeg" property="og:image:type" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content={SITE.url.replace("https://", "")} />
<meta property="twitter:url" content={canonical} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={socialImage} />

<!--Favicons-->
<link rel="icon" type="image/png" href="/assets/favicons/favicon.png" sizes="256x256" />
<link rel="apple-touch-icon" href="/assets/favicons/favicon.png" />
<meta name="apple-mobile-web-app-title" content="Cafetería La Movie" />
<link rel="manifest" href="/assets/favicons/site.webmanifest" />
