---
import { BUSINESS } from "@data/client";

// FAQ — CodeStitch 254, adapted to Cafetería La Movie:
// same structure and behavior, brand colors (cream section, red/yellow
// accents), site display type (Lilita One, uppercase) and real Q&As.
const FAQS = [
	{
		q: "¿A qué hora abren?",
		a: "Miércoles a domingo, de 6:45 PM a 12:00 AM. Lunes y martes cerrado.",
	},
	{
		q: "¿Cómo pido?",
		a: "Elige tus platos en el menú, arma tu pedido y envíalo por WhatsApp al 829-275-5220. Te confirmamos por el chat.",
	},
	{
		q: "¿Puedo recoger o es solo delivery?",
		a: "Las dos: recoge en el local o pide delivery. Cuando envíes tu pedido por WhatsApp, dinos cuál prefieres.",
	},
	{
		q: "¿Dónde están?",
		a: "S1 Los Mina Katanga #53, Santo Domingo Este.",
	},
	{
		q: "¿Tienen opciones para compartir?",
		a: "Sí: yaroas grandes, alitas fritas y más para compartir en la mesa.",
	},
];
---

<!-- ============================================ -->
<!--                    FAQ                       -->
<!-- ============================================ -->

<section id="faq-254">
	<div class="cs-container">
		<div class="cs-content">
			<span class="cs-topper">¿Tienes dudas?</span>
			<h2 class="cs-title">Preguntas <span class="hl">frecuentes.</span></h2>
			<p class="cs-text">Lo que siempre nos preguntan antes de pedir.</p>
		</div>
		<div class="cs-flex-group">
			<ul class="cs-faq-group">
				{
					FAQS.map((item, i) => (
						<li class={`cs-faq-item${i === 0 ? " active" : ""}`}>
							<button
								type="button"
								class="cs-button"
								aria-expanded={i === 0 ? "true" : "false"}
							>
								{item.q}
							</button>
							<p class="cs-item-p">{item.a}</p>
						</li>
					))
				}
			</ul>
			<div class="cs-cta">
				<h3 class="cs-h3">¿No ves la respuesta que buscas?</h3>
				<p class="cs-cta-p">Escríbenos por WhatsApp y te respondemos.</p>
				<a
					href={BUSINESS.whatsapp}
					target="_blank"
					rel="noopener"
					class="cs-button-solid"
				>
					Escríbenos por WhatsApp
				</a>
			</div>
		</div>
	</div>
</section>

<style lang="less">
	/*-- -------------------------- -->
	<---            FAQ             -->
	<--- -------------------------- -*/

	/* Mobile - 360px */
	#faq-254 {
		padding: var(--sectionPadding);
		// dark like the rest of the site — the body is #000 by design,
		// so the section takes the page background, no cream block.
		background: transparent;

		.cs-container {
			width: 100%;
			/* changes to 1280px at tablet */
			max-width: (550/16rem);
			margin: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
			/* 48px - 64px */
			gap: clamp(3rem, 6vw, 4rem);
		}

		.cs-content {
			/* set text align to left if content needs to be left aligned */
			text-align: center;
			width: 100%;
			display: flex;
			flex-direction: column;
			/* centers content horizontally, set to flex-start to left align */
			align-items: center;
		}

		// site display type: Lilita One, uppercase, cream on black;
		// .hl in brand red (yellow is unreadable on cream, red pops on black).
		.cs-title {
			font-family: var(--font-display);
			font-weight: 400;
			font-size: clamp(2.1rem, 6cqw, 3.6rem);
			line-height: 1em;
			text-transform: uppercase;
			color: #f5efe6;
			margin: 0;

			.hl {
				color: var(--primary);
			}
		}

		.cs-text {
			font-size: clamp(1rem, 2vw, 1.15rem);
			line-height: 1.5em;
			color: #cfc8b8;
			margin: (12/16rem) 0 0;
		}

		.cs-faq-group {
			padding: 0;
			margin: 0;
			margin-bottom: (48/16rem);
			width: 100%;
		}

		.cs-faq-item {
			list-style: none;
			border-bottom: 1px solid #232323;
			transition: border-bottom 0.3s;

			&.active {
				border-bottom: 1px solid var(--primary);
				.cs-button {
					&:before {
						transform: rotate(180deg);
					}
					&:after {
						opacity: 0;
						transform: rotate(360deg);
					}
				}
				.cs-item-p {
					height: auto;
					/* 12px - 16px */
					margin-bottom: clamp(0.75rem, 1.3vw, 1rem);
					opacity: 1;
				}
			}
		}

		.cs-button {
			/* 16px - 20px */
			font-size: clamp(1rem, 2vw, 1.25rem);
			line-height: 1.2em;
			text-align: left;
			font-weight: bold;
			/* 12px - 16px */
			padding: clamp(0.75rem, 1.3vw, 1rem) 0;
			background: transparent;
			border: none;
			color: #f5efe6;
			display: block;
			width: 100%;
			position: relative;

			&:hover {
				cursor: pointer;
			}

			&:before {
				/* plus sign */
				content: "";
				width: (12/16rem);
				height: (2/16rem);
				background: #f5efe6;
				opacity: 1;
				position: absolute;
				display: block;
				top: 50%;
				right: (4/16rem);
				transition: transform 0.3s;
			}

			&:after {
				/* plus sign */
				content: "";
				width: (12/16rem);
				height: (2/16rem);
				background: #f5efe6;
				opacity: 1;
				position: absolute;
				display: block;
				top: 50%;
				right: (4/16rem);
				transform: rotate(90deg);
				transform-origin: center;
				transition:
					opacity 0.5s,
					transform 0.3s;
			}
		}

		.cs-item-p {
			/* 14px - 16px */
			font-size: clamp(0.875rem, 1.5vw, 1rem);
			line-height: 1.5em;
			width: 90%;
			height: 0;
			margin: 0;
			opacity: 0;
			color: #a8a8a8;
			/* clips the text so it doesn't show up */
			overflow: hidden;
			transition:
				opacity 0.3s,
				margin-bottom 0.3s;
		}

		.cs-cta {
			text-align: center;
			/* 48px - 64px top & bottom */
			/* 40px - 56px left & right */
			padding: clamp(3rem, 4.9vw, 4rem) clamp(2.5rem, 4vw, 3.5rem);
			background: #141414;
			border: 1px solid #232323;
			border-radius: (16/16rem);
			/* prevents padding from adding to width and height */
			box-sizing: border-box;
		}

		.cs-h3 {
			/* 25px - 31px */
			font-size: clamp(1.5625rem, 3vw, 1.9375rem);
			line-height: 1.2em;
			font-weight: bold;
			text-align: center;
			margin: 0;
			margin-bottom: (16/16rem);
			color: #f5efe6;
		}

		.cs-cta-p {
			/* 16px - 20px */
			font-size: clamp(1rem, 2vw, 1.25rem);
			text-align: center;
			line-height: 1.5em;
			margin: 0;
			/* 32px - 48px */
			margin-bottom: clamp(2rem, 3.9vw, 3rem);
			color: #cfc8b8;
		}

		.cs-button-solid {
			font-size: (16/16rem);
			// single-line height on desktop, but height must be auto, not
			// the global .cs-button-solid's fixed 50px — on mobile the
			// uppercase label wraps to two lines and a fixed height clips
			// the second line.
			line-height: 1.35em;
			height: auto;
			text-decoration: none;
			font-weight: 700;
			text-align: center;
			margin: 0;
			color: #141414;
			min-width: (150/16rem);
			padding: (14/16rem) (24/16rem);
			background-color: var(--secondary);
			border-radius: 999px;
			display: inline-block;
			position: relative;
			z-index: 1;
			/* prevents padding from adding to the width */
			box-sizing: border-box;

			&:before {
				content: "";
				position: absolute;
				height: 100%;
				width: 0%;
				background: var(--primary);
				opacity: 1;
				top: 0;
				left: 0;
				z-index: -1;
				border-radius: 999px;
				transition: width 0.3s;
			}

			&:hover {
				color: #fff;
				&:before {
					width: 100%;
				}
			}
		}
	}

	/* Tablet - 768px */
	@media only screen and (min-width: 48em) {
		#faq-254 {
			.cs-container {
				max-width: (1080/16rem);
			}

			.cs-flex-group {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				/* 16px - 48px */
				gap: clamp(1rem, 3.5vw, 3rem);
			}

			.cs-faq-group {
				margin: 0;
				flex: 1;
			}

			.cs-cta {
				width: 38.5%;
				max-width: (413/16rem);
				/* prevents flexbox from squishing it */
				flex: none;
			}
		}
	}
</style>

<script>
	// CodeStitch 254 toggle, scoped to this section.
	// Bound on astro:page-load (initial load + every view transition) and
	// immediately for a plain load. Each item is bound once (data-faq-bound),
	// so re-binding after a navigation never double-toggles.
	function bindFaq() {
		const faqItems = Array.from(document.querySelectorAll("#faq-254 .cs-faq-item"));
		for (const item of faqItems) {
			if (item.dataset.faqBound) continue;
			item.dataset.faqBound = "true";
			const button = item.querySelector(".cs-button");
			const onClick = () => {
				item.classList.toggle("active");
				if (button) {
					button.setAttribute(
						"aria-expanded",
						item.classList.contains("active") ? "true" : "false",
					);
				}
			};
			item.addEventListener("click", onClick);
		}
	}
	bindFaq();
	document.addEventListener("astro:page-load", bindFaq);
</script>
