---
import { Font } from "astro:assets";
import { getSiteContext } from "@js/getSiteContext";

import Meta from "@components/Meta/Meta.astro";
import "@styles/root.less";

interface Props {
	title: string;
	description: string;
}

const { description, title } = Astro.props as Props;

const { lang, alternates, locale, currentHreflang, ogLocale } = await getSiteContext(
	Astro.url,
);
---

<html lang={lang}>
	<head>
		<!-- SEO Meta Tags -->
		<Meta
			title={title}
			description={description}
			locale={locale}
			currentHreflang={currentHreflang}
			ogLocale={ogLocale}
			alternates={alternates}
		/>

		<!-- Astro custom Font API -->
		<Font cssVariable="--font-primary" preload />
		<Font cssVariable="--font-display" preload />
	</head>
	<body>
		<!-- No <main>: root.less gives main a 105px/113px header-clearance
		     padding-top, and the cover has no header — a main wrapper
		     would push the footer below the fold. -->
		<div>
			<slot />
		</div>
	</body>
</html>
