---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import DishCard from "@components/DishCard/DishCard.astro";
import OrderBar from "@components/OrderBar/OrderBar.astro";
import VisitInfo from "@components/VisitInfo/VisitInfo.astro";
import Reviews from "@components/Reviews/Reviews.astro";
import Faq from "@components/Faq/Faq.astro";
import { BUSINESS } from "@data/client";
import { FAVORITES, getDish, dishImage } from "@data/menu";

const heroPhoto = dishImage("hero-spread.webp");
const interiorPhoto = dishImage("interior-night.webp");

const gallery = [
	{ file: "chuleta-a-la-plancha-black-plate.webp", alt: "Chuleta a la plancha con papas", dish: "chuleta" },
	{ file: "alitas-fritas-black-plate.webp", alt: "Alitas fritas", dish: "alitas" },
	{ file: "chuleta-con-ensalada-black-plate.webp", alt: "Chuleta a la plancha con ensalada", dish: "chuleta-ensalada" },
	{ file: "papa-con-queso-black-plate.webp", alt: "Papa con queso", dish: "papa-queso" },
	{ file: "pasteles-en-hoja-black-plate.webp", alt: "Pasteles en hoja", dish: "pasteles-hoja" },
	{ file: "salchipapas-black-plate.webp", alt: "Salchipapas", dish: "salchipapas" },
	{ file: "patacon-black-plate.webp", alt: "Patacón", dish: "patacon" },
	{ file: "pescado-con-fritos-black-plate.webp", alt: "Pescado con fritos", dish: "pescado-fritos" },
];

const favorites = FAVORITES.map((fav) => ({ ...fav, dish: getDish(fav.dishId) }));

const waText = (msg: string) => `${BUSINESS.whatsapp}?text=${encodeURIComponent(msg)}`;

const orderWays = [
	{
		icon: "fa6-solid:store",
		title: "Recoger",
		desc: "Pide por WhatsApp y pasa a recogerlo.",
		cta: "Pedir para recoger",
		href: waText("Hola! Quiero hacer un pedido para recoger."),
		solid: true,
	},
	{
		icon: "fa6-solid:motorcycle",
		title: "Delivery",
		desc: "Te lo llevamos a la puerta.",
		cta: "Pedir delivery",
		href: waText("Hola! Quiero hacer un pedido para delivery."),
		solid: false,
	},
	{
		icon: "fa6-solid:users",
		title: "Para la mesa",
		desc: "Yaroas grandes, alitas y más para compartir.",
		cta: "Armar pedido",
		href: waText("Hola! Quiero armar un pedido para la mesa."),
		solid: false,
	},
];

---

<BaseLayout
	title="Cafetería La Movie — Comida dominicana en Los Mina"
	description="Cafetería dominicana en Los Mina, Santo Domingo Este. Chimis, mofongo, yaroa y más, hechos al momento. Pide por WhatsApp — para recoger o a domicilio."
>
	<!-- ============================================ -->
	<!--                    Hero                      -->
	<!-- ============================================ -->
	<section class="hero">
		<span class="brace brace-l" aria-hidden="true">{"{"}</span>
		<span class="brace brace-r" aria-hidden="true">{"}"}</span>
		<div class="hero-sticker" aria-hidden="true">Abierto hasta<small>las 12:00 AM</small></div>
		<p class="hero-eyebrow">
			<span class="hero-eyebrow-dash" aria-hidden="true"></span>La Movie del Sabor<span
				class="hero-eyebrow-dash"
				aria-hidden="true"></span>
		</p>
		<h1 class="hero-title font-display">
			<span class="hero-mark">¿</span>ANTOJO<Image
				src={heroPhoto}
				alt="Chimi de pierna"
				width={840}
				height={340}
				loading="eager"
				decoding="async"
				class="hero-photo"
			/><span class="hero-mark">?</span>
			<span class="sr-only">¿Antojo?</span>
		</h1>
		<p class="hero-sub">
			Chimis, mofongo, yaroa y plátanos fritos <strong>recién hechos</strong>, en Los Mina. La
			cocina de la noche, como tiene que ser.
		</p>
		<div class="hero-cta">
			<a href="/menu/" class="cs-button-solid">Ver menú</a>
			<a href={BUSINESS.whatsapp} target="_blank" rel="noopener" class="cs-button-transparent">
				<Icon name="fa6-brands:whatsapp" aria-hidden="true" /> Pedir por WhatsApp
			</a>
		</div>
		<p class="hero-info">
			<span>Recoger o delivery</span><span class="hero-info-dot" aria-hidden="true">•</span><span
				>Mié–Dom · 6:45 PM – 12:00 AM</span
			><span class="hero-info-dot" aria-hidden="true">•</span><span>Lun y Mar cerrado</span>
		</p>

		<!-- ============================================ -->
		<!--                  Marquee                     -->
		<!-- ============================================ -->
		<div class="marquee" aria-hidden="true">
			<div class="marquee-track">
				<span>
					CHIMIS <b>•</b> MOFONGO <b>•</b> YAROA <b>•</b> PLÁTANOS FRITOS <b>•</b> ABIERTO
					TARDE <b>•</b> PICKUP O DELIVERY <b>•</b> LA MOVIE DEL SABOR <b>•</b>&nbsp;
				</span>
				<span>
					CHIMIS <b>•</b> MOFONGO <b>•</b> YAROA <b>•</b> PLÁTANOS FRITOS <b>•</b> ABIERTO
					TARDE <b>•</b> PICKUP O DELIVERY <b>•</b> LA MOVIE DEL SABOR <b>•</b>&nbsp;
				</span>
			</div>
		</div>
	</section>


	<!-- ============================================ -->
	<!--               Los más pedidos                -->
	<!-- ============================================ -->
	<section class="favorites">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">Los más pedidos</p>
				<h2 class="sec-title">Los favoritos <span class="hl-r">de la noche</span></h2>
			</div>
		</div>

		<div class="fav-track" data-fav-track>
			{
				favorites.map((fav) => (
					<DishCard
						dish={fav.dish}
						mode="favorite"
						displayName={fav.name}
						displayDesc={fav.desc}
						optionIndex={fav.optionIndex}
					/>
				))
			}
		</div>
	</section>

	<!-- ============================================ -->
	<!--                  Galería                     -->
	<!-- ============================================ -->
	<section class="gallery">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">La galería</p>
				<h2 class="sec-title">Un festín <span class="hl">para los ojos</span></h2>
			</div>
		</div>
		<div class="gallery-grid">
			{
				gallery.map((item) => (
					<a href={`/menu/${item.dish}/`} class="gallery-link" aria-label={`Ver ${item.alt}`}>
						<Image
							src={dishImage(item.file)}
							alt={item.alt}
							width={600}
							height={600}
							loading="lazy"
							decoding="async"
							class="gallery-photo"
						/>
					</a>
				))
			}
		</div>
	</section>

	<!-- ============================================ -->
	<!--              Pide a tu manera                -->
	<!-- ============================================ -->
	<section class="order-ways">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">Pide como quieras</p>
				<h2 class="sec-title">Pide a <span class="hl">tu manera.</span></h2>
			</div>
		</div>
		<p class="order-ways-sub">Recógelo caliente, te lo llevamos, o pide para toda la mesa.</p>
		<div class="order-ways-grid">
			{
				orderWays.map((w) => (
					<article class="order-way">
						<span class="order-way-icon" aria-hidden="true">
							<Icon name={w.icon} />
						</span>
						<h3 class="font-display">{w.title}</h3>
						<p>{w.desc}</p>
						<a
							href={w.href}
							target="_blank"
							rel="noopener"
							class={w.solid ? "order-btn" : "order-btn-ghost"}
						>
							{w.cta}
						</a>
					</article>
				))
			}
		</div>
	</section>




	<!-- ============================================ -->
	<!--                Cómo pedir                    -->
	<!-- ============================================ -->
	<section class="how">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">Así de fácil</p>
				<h2 class="sec-title">Cómo <span class="hl-r">pedir</span></h2>
			</div>
		</div>
		<ol class="how-steps">
			<li>
				<span class="how-num font-display">1</span>
				<h3>Elige tus platos</h3>
				<p>Explora el menú y agrega lo que se te antoje.</p>
			</li>
			<li>
				<span class="how-num font-display">2</span>
				<h3>Arma tu pedido</h3>
				<p>Elige tamaño, cantidad y revisa tu pedido abajo.</p>
			</li>
			<li>
				<span class="how-num font-display">3</span>
				<h3>Envía por WhatsApp</h3>
				<p>Tu pedido llega listo al chat — dinos pickup o delivery.</p>
			</li>
		</ol>
	</section>

	<Reviews />

	<Faq />


	<VisitInfo />

	<!-- ============================================ -->
	<!--              Conócenos teaser                -->
	<!-- ============================================ -->
	<section class="about-teaser">
		<Image
			src={interiorPhoto}
			alt="Interior de Cafetería La Movie"
			width={900}
			height={700}
			loading="lazy"
			decoding="async"
			class="about-teaser-photo"
		/>
		<div class="about-teaser-text">
			<p class="sec-kicker">Conócenos</p>
			<h2 class="sec-title">Una cafetería de Los Mina</h2>
			<p>
				En Los Mina, Katanga, servimos comida dominicana hecha al momento.
				Sin formalidades: pides por WhatsApp, recoges o te lo llevamos.
			</p>
			<a href="/conocenos/" class="cs-button-solid">Conócenos</a>
		</div>
	</section>

	<!-- ============================================ -->
	<!--                 Cierre                       -->
	<!-- ============================================ -->
	<section class="close">
		<h2 class="font-display">Pide <span class="stroke">ahora</span></h2>
		<p class="close-kicker">También tenemos</p>
		<ul class="close-extras">
			<li>Batidas</li>
			<li>Jugos naturales</li>
			<li>Bebidas</li>
			<li>Tacos</li>
			<li>Bizcocho</li>
		</ul>
		<p>Tu antojo no espera. Escríbenos y lo preparamos al momento.</p>
		<a href={BUSINESS.whatsapp} target="_blank" rel="noopener" class="cs-button-solid">
			Pedir por WhatsApp
		</a>
	</section>

	<OrderBar />
</BaseLayout>

<style lang="less">
	/*-- -------------------------- -->
	<---           Hero             -->
	<--- -------------------------- -*/
	.hero {
		text-align: center;
		padding: (54/16rem) (16/16rem) 0;
		overflow: hidden;
		position: relative;
	}

	// The proposal's braces: Lilita One TEXT glyphs, transparent fill
	// with a faint green stroke — not solid outlines, not SVGs.
	.brace {
		position: absolute;
		top: 46%;
		transform: translateY(-54%);
		font-family: var(--font-display);
		font-size: 34cqw;
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 2px rgba(95, 155, 10, 0.4);
		pointer-events: none;
		user-select: none;
	}

	.brace-l {
		left: -4cqw;
	}

	.brace-r {
		right: -4cqw;
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: (10/16rem);
		font-size: clamp(0.72rem, 1.6cqw, 0.95rem);
		font-weight: 900;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		color: var(--secondary);
		margin: 0 0 (10/16rem);
	}

	.hero-eyebrow-dash {
		display: inline-block;
		width: (34/16rem);
		height: 2px;
		background-color: var(--primary);
	}

	.hero-title {
		margin: 0;
		text-transform: uppercase;
		line-height: 0.92em;
		letter-spacing: 0.005em;
		font-size: clamp(56px, 12.2cqw, 178px);
		color: #f5efe6;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: nowrap;
		text-shadow: 0 6px 0 rgba(0, 0, 0, 0.35);
	}

	.hero-mark {
		color: var(--primary);
	}

	.hero-photo {
		flex: none;
		width: 1.9em;
		height: 0.74em;
		margin: 0 0.06em;
		border: 0.045em solid var(--secondary);
		border-radius: 999px;
		overflow: hidden;
		object-fit: cover;
		display: block;
		transform: rotate(-4deg);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
	}

	.hero-sub {
		max-width: (620/16rem);
		margin: (26/16rem) auto 0;
		font-size: clamp(1rem, 2.2cqw, 1.22rem);
		font-weight: 700;
		color: #cfc8b8;
		line-height: 1.55em;

		strong {
			color: #f5efe6;
		}
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: (14/16rem);
		margin-top: (30/16rem);

		// proposal hero buttons are mixed case (not uppercase) and a touch
		// larger. The solid one's red glow comes from the base rule, on
		// hover only — it must not be permanent here.
		// Center the label with flex: the old line-height:(56/16em) trick
		// computed to 3.5em × 18px = 63px inside a 56px button, so the
		// text sat ~3.5px below center.
		.cs-button-solid,
		.cs-button-transparent {
			text-transform: none;
			font-size: (18/16rem);
			height: (56/16rem);
			line-height: 1.2em;
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}

		.cs-button-transparent {
			display: inline-flex;
			align-items: center;
			gap: (8/16rem);

			svg {
				width: (20/16rem);
				height: (20/16rem);
				flex: none;
			}
		}
	}

	.hero-info {
		margin-top: (20/16rem);
		font-size: (15/16rem);
		font-weight: 800;
		line-height: 1.6em;
		color: #cfc8b8;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: (10/16rem);
	}

	.hero-info-dot {
		color: var(--secondaryLight);
		font-size: (12/16rem);
	}

	// The proposal's sticker: yellow, dashed dark border + solid yellow
	// outline, 9° tilt, Lilita One line + Nunito 900 small line.
	.hero-sticker {
		position: absolute;
		top: (24/16rem);
		right: 4cqw;
		transform: rotate(9deg);
		z-index: 5;
		font-family: var(--font-display);
		font-size: clamp(0.85rem, 2cqw, 1.15rem);
		line-height: 1.15em;
		color: #131313;
		background-color: var(--secondary);
		border: 2px dashed rgba(0, 0, 0, 0.35);
		outline: 3px solid var(--secondary);
		border-radius: (14/16rem);
		padding: (12/16rem) (16/16rem) (10/16rem);
		text-align: center;
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45);

		small {
			display: block;
			font-family: var(--font-primary);
			font-weight: 900;
			font-size: 0.68em;
			letter-spacing: 0.08em;
		}
	}

	@media only screen and (max-width: 1080px) {
		.brace {
			font-size: 44cqw;
		}
	}

	@media only screen and (max-width: 860px) {
		.hero-sticker {
			top: (12/16rem);
			right: (12/16rem);
		}
	}

	@media only screen and (max-width: 640px) {
		.hero {
			padding-top: (38/16rem);
		}

		.hero-title {
			font-size: clamp(40px, 12.4cqw, 110px);
		}

		.hero-photo {
			width: 1.7em;
			height: 0.68em;
		}

		// in flow, right-aligned, slight tilt — as in the proposal
		.hero-sticker {
			position: relative;
			top: auto;
			right: auto;
			width: fit-content;
			margin: 0 4px (16/16rem) auto;
			transform: rotate(6deg);
		}

		.brace {
			display: none;
		}
	}

	/*-- -------------------------- -->
	<---         Marquee            -->
	<--- -------------------------- -*/
	.marquee {
		background-color: var(--secondary);
		color: #141414;
		overflow: hidden;
		margin-top: (58/16rem);
		transform: rotate(-1.1deg) scale(1.02);
		border-top: 3px solid #141414;
		border-bottom: 3px solid #141414;
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee 26s linear infinite;

		span {
			font-family: var(--font-display);
			font-size: clamp(1.05rem, 2.6cqw, 1.6rem);
			padding: (12/16rem) 0;
			white-space: nowrap;
		}

		b {
			color: var(--accent);
			font-weight: 400;
			padding: 0 0.35em;
		}
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	/*-- -------------------------- -->
	<---      Los más pedidos       -->
	<--- -------------------------- -*/
	.favorites {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
	}

	// 4 cards, always filling the row — no carousel, no arrows, no
	// blank space left over at the end of the track.
	.fav-track {
		display: grid;
		grid-template-columns: 1fr;
		gap: (24/16rem);
	}

	@media only screen and (min-width: 40rem) {
		.fav-track {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media only screen and (min-width: 64rem) {
		.fav-track {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	/*-- -------------------------- -->
	<---         Galería            -->
	<--- -------------------------- -*/
	.gallery {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: (12/16rem);
	}

	.gallery-photo {
		width: 100%;
		height: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}

	.gallery-link {
		display: block;
		border-radius: (16/16rem);
		overflow: hidden;

		&:hover .gallery-photo,
		&:focus-visible .gallery-photo {
			transform: scale(1.06);
		}

		&:focus-visible {
			outline: 2px solid var(--secondary);
			outline-offset: 3px;
		}
	}

	@media only screen and (min-width: 64rem) {
		.gallery-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	/*-- -------------------------- -->
	<---       Cómo pedir           -->
	<--- -------------------------- -*/
	.how {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
	}

	.how-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: (24/16rem);

		li {
			border-top: 2px solid #232323;
			padding-top: (20/16rem);
		}

		h3 {
			font-size: (20/16rem);
			color: #fff;
			margin-bottom: (8/16rem);
		}

		p {
			font-size: (15/16rem);
			color: #a8a8a8;
			margin-bottom: 0;
		}
	}

	// proposal .step .num: big Lilita One number, yellow outline
	.how-num {
		font-size: (51/16rem);
		line-height: 1em;
		color: transparent;
		-webkit-text-stroke: 2px var(--secondary);
		display: block;
		margin-bottom: (12/16rem);
	}

	@media only screen and (min-width: 64rem) {
		.how-steps {
			grid-template-columns: repeat(3, 1fr);
			gap: (32/16rem);
		}
	}

	/*-- -------------------------- -->
	<---    Conócenos teaser       -->
	<--- -------------------------- -*/
	.about-teaser {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
		display: grid;
		grid-template-columns: 1fr;
		gap: (32/16rem);
		align-items: center;
	}

	.about-teaser-photo {
		width: 100%;
		height: auto;
		border-radius: (20/16rem);
		display: block;
	}

	.about-teaser-text {
		.sec-title {
			margin-bottom: (14/16rem);
		}

		p:not(.sec-kicker) {
			font-size: (17/16rem);
			line-height: 1.7em;
			color: #d4d4d4;
			margin-bottom: (24/16rem);
		}
	}

	@media only screen and (min-width: 64rem) {
		.about-teaser {
			grid-template-columns: 1fr 1fr;
			gap: (48/16rem);
		}
	}

	/*-- -------------------------- -->
	<---         Cierre             -->
	<--- -------------------------- -*/
	.close {
		text-align: center;
		padding: (90/16rem) (16/16rem) (84/16rem);

		.close-kicker {
			margin: 0 auto (12/16rem);
			font-size: (13/16rem);
			font-weight: 800;
			letter-spacing: 0.28em;
			text-transform: uppercase;
			color: var(--secondary);
		}

		// proposal .bigclose: "Pide" solid cream + "ahora" yellow outline
		h2 {
			margin: 0 0 (10/16rem);
			font-size: clamp(3rem, 11.5cqw, 10.5rem);
			line-height: 0.95em;
			text-transform: uppercase;
			color: #f5efe6;

			.stroke {
				color: transparent;
				-webkit-text-stroke: 2.5px var(--secondary);
			}
		}

		// The "También tenemos" extras, folded in from the old AlsoHave
