---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import DishCard from "@components/DishCard/DishCard.astro";
import OrderBar from "@components/OrderBar/OrderBar.astro";
import AlsoHave from "@components/AlsoHave/AlsoHave.astro";
import VisitInfo from "@components/VisitInfo/VisitInfo.astro";
import Faq from "@components/Faq/Faq.astro";
import { BUSINESS } from "@data/client";
import { CATEGORIES, FAVORITES, getDish, dishImage } from "@data/menu";

const heroPhoto = dishImage("23-chimi-de-pierna.webp");
const frontPhoto = dishImage("storefront-night.webp");
const interiorPhoto = dishImage("interior-night.webp");
const deliveryPhoto = dishImage("chimi-de-pierna-black-plate.jpg");

const gallery = [
	{ file: "chuleta-a-la-plancha-black-plate.jpg", alt: "Chuleta a la plancha con papas" },
	{ file: "alitas-fritas-black-plate.jpg", alt: "Alitas fritas" },
	{ file: "chuleta-con-ensalada-black-plate.jpg", alt: "Chuleta a la plancha con ensalada" },
	{ file: "papa-con-queso-black-plate.jpg", alt: "Papa con queso" },
	{ file: "pasteles-en-hoja-black-plate.jpg", alt: "Pasteles en hoja" },
	{ file: "salchipapas-black-plate.jpg", alt: "Salchipapas" },
	{ file: "patacon-black-plate.jpg", alt: "Patacón" },
	{ file: "pescado-con-fritos-black-plate.jpg", alt: "Pescado con fritos" },
];

const favorites = FAVORITES.map((fav) => ({ ...fav, dish: getDish(fav.dishId) }));

const waText = (msg: string) => `${BUSINESS.whatsapp}?text=${encodeURIComponent(msg)}`;

const orderWays = [
	{
		photo: frontPhoto,
		photoAlt: "Frente de Cafetería La Movie",
		title: "Recoger",
		desc: "Pide por WhatsApp y pasa a recogerlo.",
		cta: "Pedir para recoger",
		href: waText("Hola! Quiero hacer un pedido para recoger."),
		solid: true,
	},
	{
		photo: deliveryPhoto,
		photoAlt: "Chimi de pierna",
		title: "Delivery",
		desc: "Te lo llevamos a la puerta.",
		cta: "Pedir delivery",
		href: waText("Hola! Quiero hacer un pedido para delivery."),
		solid: false,
	},
	{
		photo: dishImage("mofongo-con-longaniza-black-plate.jpg"),
		photoAlt: "Mofongo con longaniza",
		title: "Para la mesa",
		desc: "Yaroas grandes, alitas y más para compartir.",
		cta: "Armar pedido",
		href: waText("Hola! Quiero armar un pedido para la mesa."),
		solid: false,
	},
];

const picks = [
	{
		dish: getDish("hamburguesa"),
		tag: "La clásica",
		name: "Hamburguesa con papas",
		desc: "Carne, queso y papas fritas.",
		price: "RD$400",
	},
	{
		dish: getDish("chimi"),
		tag: "El de siempre",
		name: "Chimi de pierna",
		desc: "Solo RD$250 · Con papas RD$350",
		price: "RD$250",
	},
	{
		dish: getDish("yaroa"),
		tag: "Para compartir",
		name: "Yaroa de res grande",
		desc: "Res, queso y salsas.",
		price: "RD$450",
	},
];
---

<BaseLayout
	title="Cafetería La Movie — Chimis, mofongo y yaroa en Santo Domingo Este"
	description="Cafetería La Movie: chimis, mofongo, yaroa y plátanos hechos al momento, de miércoles a domingo de 6:45 PM a 12 AM. Pide por WhatsApp — pickup o delivery en Santo Domingo Este."
>
	<!-- ============================================ -->
	<!--                    Hero                      -->
	<!-- ============================================ -->
	<section class="hero">
		<span class="brace brace-l" aria-hidden="true">{"{"}</span>
		<span class="brace brace-r" aria-hidden="true">{"}"}</span>
		<div class="hero-sticker" aria-hidden="true">Abierto hasta<small>las 12:00 AM</small></div>
		<p class="hero-eyebrow">
			<span class="hero-eyebrow-dash" aria-hidden="true"></span>La Movie del Sabor<span
				class="hero-eyebrow-dash"
				aria-hidden="true"></span>
		</p>
		<h1 class="hero-title font-display">
			<span class="hero-mark">¿</span>ANTOJO<Image
				src={heroPhoto}
				alt="Chimi de pierna"
				width={840}
				height={340}
				loading="eager"
				decoding="async"
				class="hero-photo"
			/><span class="hero-mark">?</span>
			<span class="sr-only">¿Antojo?</span>
		</h1>
		<p class="hero-sub">
			Chimis, mofongo, yaroa y plátanos fritos <strong>recién hechos</strong>, en Los Mina. La
			cocina de la noche, como tiene que ser.
		</p>
		<div class="hero-cta">
			<a href="/menu/" class="cs-button-solid">Ver menú</a>
			<a href={BUSINESS.whatsapp} target="_blank" rel="noopener" class="cs-button-transparent">
				<Icon name="fa6-brands:whatsapp" aria-hidden="true" /> Pedir por WhatsApp
			</a>
		</div>
		<p class="hero-info">
			<span>Pickup o delivery</span><span class="hero-info-dot" aria-hidden="true">•</span><span
				>Mié–Dom · 6:45 PM – 12:00 AM</span
			><span class="hero-info-dot" aria-hidden="true">•</span><span>Lun y Mar cerrado</span>
		</p>

		<!-- ============================================ -->
		<!--                  Marquee                     -->
		<!-- ============================================ -->
		<div class="marquee" aria-hidden="true">
			<div class="marquee-track">
				<span>
					CHIMIS <b>•</b> MOFONGO <b>•</b> YAROA <b>•</b> PLÁTANOS FRITOS <b>•</b> ABIERTO
					TARDE <b>•</b> PICKUP O DELIVERY <b>•</b> LA MOVIE DEL SABOR <b>•</b>&nbsp;
				</span>
				<span>
					CHIMIS <b>•</b> MOFONGO <b>•</b> YAROA <b>•</b> PLÁTANOS FRITOS <b>•</b> ABIERTO
					TARDE <b>•</b> PICKUP O DELIVERY <b>•</b> LA MOVIE DEL SABOR <b>•</b>&nbsp;
				</span>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!--                 Categorías                   -->
	<!-- ============================================ -->
	<section class="categories">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">Explora el menú</p>
				<h2 class="sec-title">¿Qué se te <span class="hl">antoja</span> hoy?</h2>
			</div>
		</div>
		<div class="categories-panel">
			<Image
				src={frontPhoto}
				alt="Frente de Cafetería La Movie"
				width={1600}
				height={700}
				loading="lazy"
				decoding="async"
				class="categories-bg"
			/>
			<div class="categories-overlay"></div>
			<div class="categories-content">
				<h2>Elige tu antojo</h2>
				<div class="categories-chips">
					{
						CATEGORIES.map((cat) => (
							<a href={`/menu/?categoria=${cat.id}`} class="categories-chip">
								{cat.label}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!--               Los más pedidos                -->
	<!-- ============================================ -->
	<section class="favorites">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">Los más pedidos</p>
				<h2 class="sec-title">Los favoritos <span class="hl-r">de la noche</span></h2>
			</div>
		</div>

		<div class="fav-track" data-fav-track>
			{
				favorites.map((fav) => (
					<DishCard
						dish={fav.dish}
						mode="favorite"
						displayName={fav.name}
						displayDesc={fav.desc}
						optionIndex={fav.optionIndex}
					/>
				))
			}
		</div>
	</section>

	<!-- ============================================ -->
	<!--              Pide a tu manera                -->
	<!-- ============================================ -->
	<section class="order-ways">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">Pide como quieras</p>
				<h2 class="sec-title">Pide a <span class="hl">tu manera.</span></h2>
			</div>
		</div>
		<p class="order-ways-sub">Recógelo caliente, te lo llevamos, o pide para toda la mesa.</p>
		<div class="order-ways-grid">
			{
				orderWays.map((w) => (
					<article class="order-way">
						<Image
							src={w.photo}
							alt={w.photoAlt}
							width={800}
							height={500}
							loading="lazy"
							decoding="async"
							class="order-way-photo"
						/>
						<h3 class="font-display">{w.title}</h3>
						<p>{w.desc}</p>
						<a
							href={w.href}
							target="_blank"
							rel="noopener"
							class={w.solid ? "order-btn" : "order-btn-ghost"}
						>
							{w.cta}
						</a>
					</article>
				))
			}
		</div>
	</section>

	<!-- ============================================ -->
	<!--                 Features                     -->
	<!-- ============================================ -->
	<section class="features">
		<div class="feature">
			<Icon name="fa6-solid:fire-flame-curved" aria-hidden="true" />
			<h3 class="font-display">Hecho al momento</h3>
			<p>Todo se prepara cuando pides. Nada de ayer.</p>
		</div>
		<div class="feature">
			<Icon name="fa6-solid:bag-shopping" aria-hidden="true" />
			<h3 class="font-display">Para llevar o delivery</h3>
			<p>Recoge en el local o te lo llevamos a tu casa.</p>
		</div>
		<div class="feature">
			<Icon name="fa6-solid:moon" aria-hidden="true" />
			<h3 class="font-display">Abierto de noche</h3>
			<p>Miércoles a domingo, de 6:45 PM a 12 AM.</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!--                  Galería                     -->
	<!-- ============================================ -->
	<section class="gallery">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">La galería</p>
				<h2 class="sec-title">Un festín <span class="hl">para los ojos</span></h2>
			</div>
		</div>
		<div class="gallery-grid">
			{
				gallery.map((item) => (
					<Image
						src={dishImage(item.file)}
						alt={item.alt}
						width={600}
						height={600}
						loading="lazy"
						decoding="async"
						class="gallery-photo"
					/>
				))
			}
		</div>
	</section>

	<!-- ============================================ -->
	<!--              ¿Cuál es para ti?               -->
	<!-- ============================================ -->
	<section class="picks">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">Los tres de siempre</p>
				<h2 class="sec-title">¿Cuál es <span class="hl">para ti?</span></h2>
			</div>
		</div>
		<div class="picks-grid">
			{
				picks.map((p) => (
					<article class="pick-card">
						<a
							href={`/menu/${p.dish.id}/`}
							class="pick-photo"
							aria-label={`Ver ${p.name}`}
						>
							<Image
								src={dishImage(p.dish.platePhoto ?? p.dish.photo)}
								alt={p.name}
								width={800}
								height={600}
								loading="lazy"
								decoding="async"
							/>
						</a>
						<span class="pick-tag">{p.tag}</span>
						<h3 class="font-serif">
							<a href={`/menu/${p.dish.id}/`}>{p.name}</a>
						</h3>
						<p class="pick-desc">{p.desc}</p>
						<p class="pick-price">{p.price}</p>
						<a href={`/menu/${p.dish.id}/`} class="order-btn">
							Pedir este
						</a>
					</article>
				))
			}
		</div>
	</section>

	<!-- ============================================ -->
	<!--                Cómo pedir                    -->
	<!-- ============================================ -->
	<section class="how">
		<div class="sec-head">
			<div>
				<p class="sec-kicker">Así de fácil</p>
				<h2 class="sec-title">Cómo <span class="hl-r">pedir</span></h2>
			</div>
		</div>
		<ol class="how-steps">
			<li>
				<span class="how-num font-display">1</span>
				<h3>Elige tus platos</h3>
				<p>Explora el menú y agrega lo que se te antoje.</p>
			</li>
			<li>
				<span class="how-num font-display">2</span>
				<h3>Arma tu pedido</h3>
				<p>Elige tamaño, cantidad y revisa tu pedido abajo.</p>
			</li>
			<li>
				<span class="how-num font-display">3</span>
				<h3>Envía por WhatsApp</h3>
				<p>Tu pedido llega listo al chat — dinos pickup o delivery.</p>
			</li>
		</ol>
	</section>

	<Faq />

	<!-- ============================================ -->
	<!--              Conócenos teaser                -->
	<!-- ============================================ -->
	<section class="about-teaser">
		<Image
			src={interiorPhoto}
			alt="Interior de Cafetería La Movie"
			width={900}
			height={700}
			loading="lazy"
			decoding="async"
			class="about-teaser-photo"
		/>
		<div class="about-teaser-text">
			<p class="sec-kicker">Conócenos</p>
			<h2 class="sec-title">Una cafetería de barrio, de noche</h2>
			<p>
				En Los Mina, Katanga, servimos comida dominicana hecha al momento, de noche.
				Sin formalidades: pides por WhatsApp, recoges o te lo llevamos.
			</p>
			<a href="/conocenos/" class="cs-button-solid">Conócenos</a>
		</div>
	</section>

	<VisitInfo />
	<AlsoHave />

	<!-- ============================================ -->
	<!--                 Cierre                       -->
	<!-- ============================================ -->
	<section class="close">
		<h2 class="font-display">Pide <span class="stroke">ahora</span></h2>
		<p>Tu antojo no espera. Escríbenos y lo preparamos al momento.</p>
		<a href={BUSINESS.whatsapp} target="_blank" rel="noopener" class="cs-button-solid">
			Pedir por WhatsApp
		</a>
	</section>

	<OrderBar />
</BaseLayout>

<style lang="less">
	/*-- -------------------------- -->
	<---           Hero             -->
	<--- -------------------------- -*/
	.hero {
		text-align: center;
		padding: (54/16rem) (16/16rem) 0;
		overflow: hidden;
		position: relative;
	}

	// The proposal's braces: Lilita One TEXT glyphs, transparent fill
	// with a faint green stroke — not solid outlines, not SVGs.
	.brace {
		position: absolute;
		top: 46%;
		transform: translateY(-54%);
		font-family: var(--font-display);
		font-size: 34cqw;
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 2px rgba(95, 155, 10, 0.4);
		pointer-events: none;
		user-select: none;
	}

	.brace-l {
		left: -4cqw;
	}

	.brace-r {
		right: -4cqw;
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: (10/16rem);
		font-size: clamp(0.72rem, 1.6cqw, 0.95rem);
		font-weight: 900;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		color: var(--secondary);
		margin: 0 0 (10/16rem);
	}

	.hero-eyebrow-dash {
		display: inline-block;
		width: (34/16rem);
		height: 2px;
		background-color: var(--primary);
	}

	.hero-title {
		margin: 0;
		text-transform: uppercase;
		line-height: 0.92em;
		letter-spacing: 0.005em;
		font-size: clamp(56px, 12.2cqw, 178px);
		color: #f5efe6;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: nowrap;
		text-shadow: 0 6px 0 rgba(0, 0, 0, 0.35);
	}

	.hero-mark {
		color: var(--primary);
	}

	.hero-photo {
		flex: none;
		width: 1.9em;
		height: 0.74em;
		margin: 0 0.06em;
		border: 0.045em solid var(--secondary);
		border-radius: 999px;
		overflow: hidden;
		object-fit: cover;
		display: block;
		transform: rotate(-4deg);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
	}

	.hero-sub {
		max-width: (620/16rem);
		margin: (26/16rem) auto 0;
		font-size: clamp(1rem, 2.2cqw, 1.22rem);
		font-weight: 700;
		color: #cfc8b8;
		line-height: 1.55em;

		strong {
			color: #f5efe6;
		}
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: (14/16rem);
		margin-top: (30/16rem);

		// proposal hero buttons are mixed case (not uppercase) and a touch
		// larger, with a soft red glow on the solid one.
		// Center the label with flex: the old line-height:(56/16em) trick
		// computed to 3.5em × 18px = 63px inside a 56px button, so the
		// text sat ~3.5px below center.
		.cs-button-solid,
		.cs-button-transparent {
			text-transform: none;
			font-size: (18/16rem);
			height: (56/16rem);
			line-height: 1.2em;
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}

		.cs-button-solid {
			box-shadow: 0 (8/16rem) (24/16rem) rgba(254, 5, 0, 0.45);
		}

		.cs-button-transparent {
			display: inline-flex;
			align-items: center;
			gap: (8/16rem);

			svg {
				width: (20/16rem);
				height: (20/16rem);
				flex: none;
			}
		}
	}

	.hero-info {
		margin-top: (20/16rem);
		font-size: (15/16rem);
		font-weight: 800;
		line-height: 1.6em;
		color: #cfc8b8;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: (10/16rem);
	}

	.hero-info-dot {
		color: var(--secondaryLight);
		font-size: (12/16rem);
	}

	// The proposal's sticker: yellow, dashed dark border + solid yellow
	// outline, 9° tilt, Lilita One line + Nunito 900 small line.
	.hero-sticker {
		position: absolute;
		top: (24/16rem);
		right: 4cqw;
		transform: rotate(9deg);
		z-index: 5;
		font-family: var(--font-display);
		font-size: clamp(0.85rem, 2cqw, 1.15rem);
		line-height: 1.15em;
		color: #131313;
		background-color: var(--secondary);
		border: 2px dashed rgba(0, 0, 0, 0.35);
		outline: 3px solid var(--secondary);
		border-radius: (14/16rem);
		padding: (12/16rem) (16/16rem) (10/16rem);
		text-align: center;
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45);

		small {
			display: block;
			font-family: var(--font-primary);
			font-weight: 900;
			font-size: 0.68em;
			letter-spacing: 0.08em;
		}
	}

	@media only screen and (max-width: 1080px) {
		.brace {
			font-size: 44cqw;
		}
	}

	@media only screen and (max-width: 860px) {
		.hero-sticker {
			top: (12/16rem);
			right: (12/16rem);
		}
	}

	@media only screen and (max-width: 640px) {
		.hero {
			padding-top: (38/16rem);
		}

		.hero-title {
			font-size: clamp(40px, 12.4cqw, 110px);
		}

		.hero-photo {
			width: 1.7em;
			height: 0.68em;
		}

		// in flow, right-aligned, slight tilt — as in the proposal
		.hero-sticker {
			position: relative;
			top: auto;
			right: auto;
			width: fit-content;
			margin: 0 4px (16/16rem) auto;
			transform: rotate(6deg);
		}

		.brace {
			display: none;
		}
	}

	/*-- -------------------------- -->
	<---         Marquee            -->
	<--- -------------------------- -*/
	.marquee {
		background-color: var(--secondary);
		color: #141414;
		overflow: hidden;
		margin-top: (58/16rem);
		transform: rotate(-1.1deg) scale(1.02);
		border-top: 3px solid #141414;
		border-bottom: 3px solid #141414;
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee 26s linear infinite;

		span {
			font-family: var(--font-display);
			font-size: clamp(1.05rem, 2.6cqw, 1.6rem);
			padding: (12/16rem) 0;
			white-space: nowrap;
		}

		b {
			color: var(--accent);
			font-weight: 400;
			padding: 0 0.35em;
		}
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	/*-- -------------------------- -->
	<---       Categorías           -->
	<--- -------------------------- -*/
	.categories {
		padding: (64/16rem) (16/16rem) 0;

		// the sec-head above the panel aligns with the 1280px panel
		.sec-head {
			max-width: (1280/16rem);
			margin: 0 auto (30/16rem);
		}
	}

	.categories-panel {
		max-width: (1280/16rem);
		margin: auto;
		border-radius: (20/16rem);
		overflow: hidden;
		position: relative;
		min-height: (420/16rem);
		display: flex;
		align-items: flex-end;
	}

	.categories-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.categories-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.45) 55%, rgba(0, 0, 0, 0.25) 100%);
	}

	.categories-content {
		position: relative;
