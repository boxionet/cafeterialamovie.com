---
// Panel del Menú — custom dashboard for Cafetería La Movie (Option 2, light version).
// Replaces the Decap CMS menu editor with a simple card UI for Frank.
// Saves back to the same src/data/menu.json via the DecapBridge git-gateway
// (same login as /admin), so the site rebuilds on every save.
// Standalone page: no public header/footer, noindex, excluded from sitemap.
import { Font } from "astro:assets";
import type { ImageMetadata } from "astro";
import menuData from "@data/menu.json";

// All dish photos (built URLs) for the cards and the photo picker.
const photoGlobs = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/dishes/*.{webp,jpg}",
	{ eager: true },
);
const photoUrls: Record<string, string> = {};
for (const [path, mod] of Object.entries(photoGlobs)) {
	const file = path.split("/").pop()!;
	photoUrls[file] = mod.default.src;
}
const photoList = Object.keys(photoUrls).sort();
const initialMenu = menuData;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Panel del Menú — Cafetería La Movie</title>
		<link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
		<!-- Apply the saved (or system) theme before paint so there's no flash -->
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem("lamovie-panel-theme");
					var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
					document.documentElement.setAttribute("data-theme", theme);
				} catch (e) {
					document.documentElement.setAttribute("data-theme", "light");
				}
			})();
		</script>
		<Font cssVariable="--font-primary" />
		<Font cssVariable="--font-display" />
		<style is:global>
			:root {
				--red: #fe0500;
				--red-dark: #bf1313;
				--yellow: #fdcc00;
				color-scheme: light;
				/* light theme */
				--ink: #1a1a1a;
				--grey: #6b6b6b;
				--line: #e8e8e8;
				--bg: #f6f6f6;
				--card: #ffffff;
				--input-bg: #ffffff;
				--pill-bg: #e9e9e9;
				--pill-ink: #333333;
				--price: #fe0500;
				--img-bg: #eeeeee;
				--shadow: rgba(0, 0, 0, 0.07);
				--modal-shadow: rgba(0, 0, 0, 0.25);
				--overlay: rgba(0, 0, 0, 0.55);
				--toast-bg: #1a1a1a;
				--toast-ink: #ffffff;
				--switch-track: #e9e9e9;
				--switch-knob: #ffffff;
			}
			:root[data-theme="dark"] {
				color-scheme: dark;
				/* dark theme — same brand, black like the site */
				--ink: #ffffff;
				--grey: #a8a8a8;
				--line: #2a2a2a;
				--bg: #000000;
				--card: #141414;
				--input-bg: #1e1e1e;
				--pill-bg: #2a2a2a;
				--pill-ink: #e0e0e0;
				--price: #fdcc00;
				--img-bg: #1e1e1e;
				--shadow: rgba(0, 0, 0, 0.45);
				--modal-shadow: rgba(0, 0, 0, 0.6);
				--overlay: rgba(0, 0, 0, 0.7);
				--toast-bg: #f5f5f5;
				--toast-ink: #1a1a1a;
				--switch-track: #2a2a2a;
				--switch-knob: #1a1a1a;
			}
			/* Smooth theme change across the whole panel */
			body, .topbar, .card, .modal, .search, .pill, .btn, .field input,
			.field textarea, .field select, .opt-remove, .picker-grid button,
			.toast, .card-price, .card-cat, .topbar h1,
			.account-btn, .account-popover, .ap-item, .ap-session, .ap-logout,
			.empty, .add-opt, .link-btn, .theme-switch, .ts-knob {
				transition: background-color 0.35s ease, color 0.35s ease,
					border-color 0.35s ease, box-shadow 0.35s ease;
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: var(--font-primary), "Nunito", Arial, sans-serif;
			}
			/* ---------- top bar ---------- */
			.topbar {
				position: sticky;
				top: 0;
				z-index: 20;
				background: var(--card);
				border-bottom: 1px solid var(--line);
			}
			.topbar-inner {
				max-width: 1200px;
				margin: 0 auto;
				padding: 12px 20px;
				display: flex;
				align-items: center;
				gap: 16px;
			}
			.topbar .logo { height: 4.5rem; width: auto; flex: none; }
			.topbar h1 {
				font-family: var(--font-display), "Lilita One", "Arial Black", sans-serif;
				font-size: clamp(1.5rem, 3.4vw, 2rem);
				text-transform: uppercase;
				letter-spacing: 0.02em;
				margin: 0;
				line-height: 1;
			}
			.topbar .spacer { flex: 1; }
			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 6px;
				border: 0;
				border-radius: 999px;
				padding: 10px 18px;
				font-family: inherit;
				font-size: 0.95rem;
				font-weight: 800;
				cursor: pointer;
				text-decoration: none;
				white-space: nowrap;
			}
			.btn-outline {
				background: var(--card);
				color: var(--ink);
				border: 1.5px solid var(--line);
			}
			.btn-outline:hover { border-color: var(--ink); }
			.btn-red { background: var(--red); color: #fff; }
			.btn-red:hover { background: var(--red-dark); }
			.btn-red:disabled { opacity: 0.55; cursor: wait; }
			/* ---------- theme switch (sun / moon) ---------- */
			.theme-switch {
				flex: none;
				width: 64px;
				height: 34px;
				border-radius: 999px;
				border: 1.5px solid var(--line);
				background: var(--switch-track);
				position: relative;
				cursor: pointer;
				padding: 0;
			}
			.theme-switch:focus-visible {
				outline: 2px solid var(--red);
				outline-offset: 2px;
			}
			.theme-switch .ts-knob {
				position: absolute;
				top: 50%;
				left: 3px;
				width: 26px;
				height: 26px;
				border-radius: 50%;
				background: var(--switch-knob);
				box-shadow: 0 2px 6px rgba(0, 0, 0, 0.28);
				transform: translateY(-50%) translateX(0);
				transition: transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
					background-color 0.35s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
			}
			:root[data-theme="dark"] .theme-switch .ts-knob {
				transform: translateY(-50%) translateX(29px);
			}
			.theme-switch .ts-knob svg {
				position: absolute;
				width: 16px;
				height: 16px;
				transition: opacity 0.3s ease, transform 0.38s ease;
			}
			.theme-switch .ts-sun {
				color: #f59e0b;
				opacity: 1;
				transform: rotate(0deg) scale(1);
			}
			.theme-switch .ts-moon {
				color: var(--yellow);
				opacity: 0;
				transform: rotate(90deg) scale(0.6);
			}
			:root[data-theme="dark"] .theme-switch .ts-sun {
				opacity: 0;
				transform: rotate(-90deg) scale(0.6);
			}
			:root[data-theme="dark"] .theme-switch .ts-moon {
				opacity: 1;
				transform: rotate(0deg) scale(1);
			}
			/* ---------- account menu (person icon + popover) ---------- */
			.account-menu { position: relative; flex: none; }
			.account-btn {
				width: 44px;
				height: 44px;
				border-radius: 50%;
				border: 1.5px solid var(--line);
				background: var(--card);
				color: var(--ink);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 0;
			}
			.account-btn:hover { border-color: var(--red); color: var(--red); }
			.account-btn:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
			.account-btn svg { width: 24px; height: 24px; }
			.account-popover {
				position: absolute;
				top: calc(100% + 10px);
				right: 0;
				min-width: 250px;
				background: var(--card);
				border: 1px solid var(--line);
				border-radius: 14px;
				box-shadow: 0 10px 30px var(--modal-shadow);
				padding: 8px;
				z-index: 40;
				display: flex;
				flex-direction: column;
				gap: 2px;
			}
			.account-popover[hidden] { display: none; }
			.ap-session {
				margin: 0;
				padding: 10px 12px 12px;
				font-size: 0.92rem;
				font-weight: 800;
				color: var(--ink);
				border-bottom: 1px solid var(--line);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.ap-session[hidden] { display: none; }
			.ap-item {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				padding: 10px 12px;
				border-radius: 9px;
				font-size: 0.98rem;
				font-weight: 700;
				color: var(--ink);
				text-decoration: none;
				cursor: pointer;
				background: none;
				border: 0;
				font-family: inherit;
				text-align: left;
				width: 100%;
			}
			a.ap-item:hover { background: var(--input-bg); }
			.ap-theme { cursor: default; }
			.ap-logout {
				width: 100%;
				margin-top: 6px;
				padding: 11px 16px;
				border-radius: 10px;
				border: 0;
				background: var(--red);
				color: #fff;
				font-family: inherit;
				font-size: 1rem;
				font-weight: 800;
				cursor: pointer;
				text-align: center;
			}
			.ap-logout:hover { background: var(--red-dark); }
			/* ---------- toolbar ---------- */
			.toolbar {
				max-width: 1200px;
				margin: 0 auto;
				padding: 24px 20px 8px;
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				align-items: center;
			}
			.search {
				flex: 1 1 260px;
				display: flex;
				align-items: center;
				gap: 8px;
				background: var(--card);
				border: 1.5px solid var(--line);
				border-radius: 999px;
				padding: 10px 16px;
			}
			.search input {
				border: 0;
				outline: 0;
				flex: 1;
				font-family: inherit;
				font-size: 1rem;
				background: transparent;
				color: var(--ink);
			}
			.pills {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				flex: 1 1 100%;
			}
			.pill {
				border: 0;
				border-radius: 999px;
				padding: 9px 16px;
				font-family: inherit;
				font-size: 0.92rem;
				font-weight: 700;
				background: var(--pill-bg);
				color: var(--pill-ink);
				cursor: pointer;
			}
			.pill.active { background: var(--red); color: #fff; }
			/* ---------- dish grid ---------- */
			.grid {
				max-width: 1200px;
				margin: 0 auto;
				padding: 16px 20px 48px;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
				gap: 20px;
			}
			.card {
				background: var(--card);
				border-radius: 16px;
				overflow: hidden;
				box-shadow: 0 2px 10px var(--shadow);
				display: flex;
				flex-direction: column;
			}
			.card img {
				width: 100%;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				background: var(--img-bg);
				display: block;
			}
			.card-body {
				padding: 16px 18px 18px;
				display: flex;
				flex-direction: column;
				gap: 4px;
				flex: 1;
			}
			.card-body h2 { font-size: 1.25rem; margin: 0; line-height: 1.2; }
			.card-cat { font-size: 0.88rem; color: var(--grey); }
			.card-price {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--price);
				margin: 4px 0 10px;
			}
			.card .btn-outline { width: 100%; }
			.empty {
				max-width: 1200px;
				margin: 0 auto;
				padding: 40px 20px;
				text-align: center;
				color: var(--grey);
				font-size: 1.05rem;
			}
			/* ---------- modals ---------- */
			.overlay {
				position: fixed;
				inset: 0;
				background: var(--overlay);
				z-index: 50;
				display: none;
				align-items: flex-start;
				justify-content: center;
				padding: 24px 16px;
				overflow-y: auto;
			}
			.overlay.open { display: flex; }
			.modal {
				background: var(--card);
				border-radius: 20px;
				width: 100%;
				max-width: 760px;
				margin: auto 0;
				overflow: hidden;
				box-shadow: 0 12px 40px var(--modal-shadow);
			}
			.modal h2 {
				font-family: var(--font-display), "Lilita One", "Arial Black", sans-serif;
				font-size: 1.8rem;
				text-transform: uppercase;
				margin: 0;
				padding: 22px 24px 0;
			}
			/* Two-column body: photo on the left, form on the right. */
			.modal-body { display: flex; gap: 24px; padding: 16px 24px 24px; align-items: flex-start; }
			.modal-body .photo-wrap { flex: 0 0 250px; position: relative; margin: 0; border-radius: 14px; overflow: hidden; }
			.modal-body .photo-wrap img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; background: var(--img-bg); }
			.modal .photo-wrap .change-photo {
				position: absolute;
				right: 12px;
				bottom: 12px;
				background: rgba(0, 0, 0, 0.72);
				color: #fff;
				border: 1.5px solid var(--yellow);
				border-radius: 999px;
				padding: 8px 14px;
				font-family: inherit;
				font-weight: 800;
				font-size: 0.9rem;
				cursor: pointer;
			}
			.modal-body form { flex: 1; min-width: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
			.field label { display: block; font-weight: 800; font-size: 0.92rem; margin-bottom: 6px; }
			.field input,
			.field textarea,
			.field select {
				width: 100%;
				border: 1.5px solid var(--line);
				border-radius: 10px;
				padding: 11px 12px;
				font-family: inherit;
				font-size: 1rem;
				background: var(--input-bg);
				color: var(--ink);
			}
			.field input:focus,
			.field textarea:focus,
			.field select:focus { outline: 2px solid var(--red); outline-offset: 0; border-color: var(--red); }
			.field textarea { resize: vertical; min-height: 64px; }
			.opt-row { display: flex; gap: 8px; align-items: center; }
			.opt-row input:first-child { flex: 1 1 auto; min-width: 0; }
			.opt-row input.price { flex: 0 0 96px; min-width: 0; }
			.opt-remove {
				flex: none;
				width: 38px;
				height: 38px;
				border-radius: 50%;
				border: 1.5px solid var(--line);
				background: var(--card);
				color: var(--ink);
				font-size: 1.05rem;
				line-height: 1;
				cursor: pointer;
			}
			.opt-remove:hover { border-color: var(--red); color: var(--red); }
			.add-opt {
				background: none;
				border: 0;
				color: var(--red);
				font-family: inherit;
				font-weight: 800;
				font-size: 0.95rem;
				cursor: pointer;
				text-align: left;
				padding: 0;
			}
			.modal-actions { display: flex; align-items: center; gap: 16px; margin-top: 6px; flex-wrap: wrap; }
			.modal-actions .btn-red { flex: 1; padding: 13px 18px; font-size: 1.05rem; }
			.link-btn {
				background: none;
				border: 0;
				font-family: inherit;
				font-size: 1rem;
				color: var(--grey);
				text-decoration: underline;
				cursor: pointer;
			}
			.danger { color: var(--red); }
			/* Modal: single column on narrow screens, photo as a short banner. */
			@media (max-width: 720px) {
				.modal h2 { font-size: 1.5rem; padding: 18px 20px 0; }
				.modal-body { flex-direction: column; gap: 14px; padding: 14px 20px 20px; }
				.modal-body .photo-wrap { flex: none; }
				.modal-body .photo-wrap img { aspect-ratio: 21 / 9; max-height: 150px; }
				.modal-body form { gap: 11px; }
			}
			/* photo picker */
			.picker-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
				gap: 10px;
				padding: 18px 24px;
				max-height: 46vh;
				overflow-y: auto;
			}
			.picker-grid button {
				border: 2px solid transparent;
				border-radius: 12px;
				overflow: hidden;
				padding: 0;
				cursor: pointer;
				background: var(--img-bg);
			}
			.picker-grid button.selected { border-color: var(--red); }
			.picker-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
			.picker-foot { padding: 0 24px 22px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
			.picker-foot .hint { font-size: 0.88rem; color: var(--grey); }
			/* toast */
			.toast {
				position: fixed;
				left: 50%;
				bottom: 24px;
				transform: translateX(-50%) translateY(20px);
				background: var(--toast-bg);
				color: var(--toast-ink);
				border-radius: 999px;
				padding: 12px 22px;
				font-weight: 700;
				font-size: 0.98rem;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.2s, transform 0.2s;
				z-index: 100;
				max-width: calc(100vw - 32px);
				text-align: center;
			}
			.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
			.toast.error { background: var(--red); color: #fff; }
			/* ---------- login gate (shown when not logged in) ---------- */
			.login-gate {
				max-width: 480px;
				margin: 0 auto;
				padding: 72px 20px 40px;
				text-align: center;
			}
			.login-gate .logo { height: 96px; width: auto; }
			.login-gate h2 {
				font-family: var(--font-display), "Lilita One", "Arial Black", sans-serif;
				font-size: clamp(1.7rem, 5vw, 2.1rem);
				text-transform: uppercase;
				letter-spacing: 0.02em;
				margin: 20px 0 8px;
				line-height: 1.1;
			}
			.login-gate p {
				color: var(--grey);
				font-size: 1.05rem;
				line-height: 1.55;
				margin: 0 0 26px;
			}
			.login-gate .btn-red { padding: 14px 34px; font-size: 1.08rem; }
			.login-gate .gate-note { font-size: 0.9rem; margin: 18px 0 0; }
			/* Logo sizes in rem: desktop 4.5rem, tablet 4rem, mobile 3.75rem. */
			@media (max-width: 1024px) {
				.topbar .logo { height: 4rem; }
			}
			@media (max-width: 640px) {
				.topbar-inner { gap: 10px; padding: 10px 14px; }
				.topbar .logo { height: 3.75rem; }
				.topbar h1 { font-size: 1.3rem; }
				.topbar .btn { padding: 9px 13px; font-size: 0.88rem; }
			}
			@media (max-width: 480px) {
				/* Add button goes full-width under the search instead of floating alone */
				.toolbar .btn-red { flex: 1 1 100%; justify-content: center; }
				/* Modal actions: save on its own row, Cancel / Delete share the next row */
				.modal-actions .btn-red { flex: 1 1 100%; }
				.modal-actions .link-btn { flex: 1; text-align: center; }
			}
			@media (max-width: 400px) {
				.topbar h1 { font-size: 1rem; }
				.topbar .btn { padding: 8px 11px; font-size: 0.85rem; }
				.theme-switch { width: 58px; height: 32px; }
				.theme-switch .ts-knob { width: 24px; height: 24px; }
				:root[data-theme="dark"] .theme-switch .ts-knob {
					transform: translateY(-50%) translateX(27px);
				}
			}
		</style>
	</head>
	<body>
		<header class="topbar">
			<div class="topbar-inner">
				<img class="logo" src="/assets/logo.svg" alt="Cafetería La Movie" />
				<h1>Panel del Menú</h1>
				<div class="spacer"></div>
				<div class="account-menu">
					<button class="account-btn" id="accountBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Menú de cuenta">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="8" r="4" />
							<path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" />
						</svg>
					</button>
					<div class="account-popover" id="accountPopover" hidden>
						<p class="ap-session" id="userChip" hidden></p>
						<a class="ap-item" id="apVerSitio" href="/" target="_blank" rel="noopener">Ver sitio</a>
						<div class="ap-item ap-theme">
							<span>Modo oscuro</span>
							<button class="theme-switch" id="themeSwitch" type="button" role="switch" aria-checked="false" aria-label="Cambiar entre modo claro y oscuro" title="Cambiar entre modo claro y oscuro">
								<span class="ts-knob">
									<svg class="ts-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
										<circle cx="12" cy="12" r="4" fill="currentColor" stroke="none" />
										<path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" />
									</svg>
									<svg class="ts-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
									</svg>
								</span>
							</button>
						</div>
						<button class="ap-logout" id="loginBtn" type="button">Iniciar sesión</button>
					</div>
				</div>
			</div>
		</header>

		<div class="login-gate" id="loginGate" hidden>
			<img class="logo" src="/assets/logo.svg" alt="Cafetería La Movie" />
			<h2>Panel del Menú</h2>
			<p>Inicia sesión con tu cuenta de Decap CMS para ver y editar el menú.</p>
			<button class="btn btn-red" id="gateLoginBtn" type="button">Iniciar sesión</button>
			<p class="gate-note">Solo las personas invitadas pueden entrar.</p>
		</div>

		<div id="dashboard" hidden>
		<div class="toolbar">
			<label class="search">
				<span aria-hidden="true">🔍</span>
				<input id="searchInput" type="search" placeholder="Buscar plato..." autocomplete="off" />
			</label>
			<button class="btn btn-red" id="addBtn" type="button">+ Agregar plato</button>
			<div class="pills" id="pills"></div>
		</div>

		<main class="grid" id="grid"></main>
		<p class="empty" id="emptyMsg" hidden>No hay platos con ese filtro.</p>
		</div>

		<!-- Edit / add dish -->
		<div class="overlay" id="editOverlay" role="dialog" aria-modal="true" aria-label="Editar plato">
			<div class="modal">
				<h2 id="editTitle">Editar plato</h2>
				<div class="modal-body">
					<div class="photo-wrap">
						<img id="editPhoto" src="" alt="Foto del plato" />
						<button class="change-photo" id="changePhotoBtn" type="button">📷 Cambiar foto</button>
					</div>
					<form id="editForm">
						<div class="field">
							<label for="fName">Nombre</label>
							<input id="fName" required maxlength="80" />
						</div>
						<div class="field">
							<label for="fDesc">Descripción</label>
							<textarea id="fDesc" maxlength="200" rows="2"></textarea>
						</div>
						<div class="field">
							<label for="fCat">Categoría</label>
							<select id="fCat"></select>
						</div>
						<div class="field">
							<label>Opciones y precios</label>
							<div id="optList" style="display:flex;flex-direction:column;gap:10px;"></div>
							<button class="add-opt" id="addOptBtn" type="button">+ Agregar opción</button>
						</div>
						<div class="modal-actions">
							<button class="btn btn-red" id="saveDishBtn" type="submit">Guardar cambios</button>
							<button class="link-btn" id="cancelEditBtn" type="button">Cancelar</button>
							<button class="link-btn danger" id="deleteDishBtn" type="button">Eliminar plato</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		<!-- Photo picker -->
		<div class="overlay" id="pickerOverlay" role="dialog" aria-modal="true" aria-label="Elegir foto">
			<div class="modal">
				<h2>Elegir foto</h2>
				<div class="picker-grid" id="pickerGrid"></div>
				<div class="picker-foot">
					<label class="btn btn-outline" for="uploadInput">Subir nueva foto</label>
					<input id="uploadInput" type="file" accept=".webp,.jpg,.jpeg" hidden />
					<span class="hint">Solo .webp o .jpg. La foto se sube al guardar.</span>
					<button class="link-btn" id="closePickerBtn" type="button">Cerrar</button>
				</div>
			</div>
		</div>

		<div class="toast" id="toast" role="status"></div>

		<script define:vars={{ initialMenu, photoUrls, photoList }}>
			// ---- config (same backend as Decap CMS /admin) ----
			const SITE_ID = "e9d365da-e6b0-4e5f-8f21-53fdb0281303";
			const AUTH_BASE = "https://auth.decapbridge.com";
			const GATEWAY = "https://gateway.decapbridge.com/github";
			const REPO = "boxionet/cafeterialamovie.com";
			const BRANCH = "main";
			const MENU_PATH = "src/data/menu.json";
			const DISHES_DIR = "src/assets/images/dishes";
			const TOKEN_KEY = "lamovie-panel-token";
			const VERIFIER_KEY = "lamovie-panel-verifier";
			const NONCE_KEY = "lamovie-panel-nonce";

			// ---- state ----
			const menu = JSON.parse(JSON.stringify(initialMenu));
			let filter = "all";
			let query = "";
			let token = localStorage.getItem(TOKEN_KEY) || "";
			let editingId = null; // dish id, or null for a new dish
			let editingPhoto = ""; // chosen photo filename
			let pendingUpload = null; // {file, name, dataUrl} — uploaded on save
			let pickerTarget = "photo";

			const $ = (id) => document.getElementById(id);
			const grid = $("grid"), pillsEl = $("pills"), emptyMsg = $("emptyMsg");
			const toastEl = $("toast");

			let toastTimer = null;
			function toast(msg, isError) {
				toastEl.textContent = msg;
				toastEl.classList.toggle("error", !!isError);
				toastEl.classList.add("show");
				clearTimeout(toastTimer);
				toastTimer = setTimeout(() => toastEl.classList.remove("show"), 4200);
			}

			function esc(s) {
				return String(s ?? "").replace(/[&<>"']/g, (c) => ({
					"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
				})[c]);
			}
			function photoUrl(file) { return photoUrls[file] || ""; }
			function displayPhoto(d) { return photoUrl(d.platePhoto || d.photo); }
			function minPrice(d) {
				if (!d.options || !d.options.length) return null;
				return Math.min(...d.options.map((o) => o.price));
			}
			function priceLabel(d) {
				const p = minPrice(d);
				if (p == null) return "Sin precio";
				return (d.options.length > 1 ? "desde " : "") + "RD$" + p;
			}
			function catLabel(id) {
				const c = menu.categories.find((c) => c.id === id);
				return c ? c.label : id;
			}
			function slugify(s) {
				return String(s).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
					.replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "").slice(0, 60) || "plato";
			}

			// ---- render ----
			function renderPills() {
				const all = [{ id: "all", label: "Todos" }, ...menu.categories];
				pillsEl.innerHTML = all.map((c) =>
					`<button type="button" class="pill${filter === c.id ? " active" : ""}" data-cat="${esc(c.id)}">${esc(c.label)}</button>`
				).join("");
				pillsEl.querySelectorAll(".pill").forEach((b) =>
					b.addEventListener("click", () => { filter = b.dataset.cat; renderPills(); renderGrid(); })
				);
			}
			function renderGrid() {
				const q = query.trim().toLowerCase();
				const list = menu.dishes.filter((d) =>
					(filter === "all" || d.category === filter) &&
					(!q || d.name.toLowerCase().includes(q))
				);
				emptyMsg.hidden = list.length > 0;
				grid.innerHTML = list.map((d) => {
					const img = displayPhoto(d);
					return `<article class="card">
						${img ? `<img src="${esc(img)}" alt="${esc(d.name)}" loading="lazy" />` : ""}
						<div class="card-body">
							<h2>${esc(d.name)}</h2>
							<span class="card-cat">${esc(catLabel(d.category))}</span>
							<span class="card-price">${esc(priceLabel(d))}</span>
							<button type="button" class="btn btn-outline" data-edit="${esc(d.id)}">Editar</button>
						</div>
					</article>`;
				}).join("");
				grid.querySelectorAll("[data-edit]").forEach((b) =>
					b.addEventListener("click", () => openEdit(b.dataset.edit))
				);
			}

			// ---- edit modal ----
			function optRowHTML(opt) {
				return `<div class="opt-row">
					<input type="text" class="opt-label" value="${esc(opt.label)}" placeholder="Opción (ej. Sola)" maxlength="40" />
					<input type="number" class="opt-price price" value="${opt.price}" min="0" step="1" placeholder="RD$" />
					<button type="button" class="opt-remove" title="Quitar opción" aria-label="Quitar opción">×</button>
				</div>`;
			}
			function openEdit(id) {
				const isNew = !id;
				editingId = isNew ? null : id;
				const d = isNew
					? { id: "", name: "", desc: "", category: menu.categories[0]?.id || "", photo: "", platePhoto: "", options: [{ label: "Sola", price: 0 }] }
					: menu.dishes.find((x) => x.id === id);
				if (!d) return;
				editingPhoto = d.platePhoto || d.photo || "";
				pendingUpload = null;
				$("editTitle").textContent = isNew ? "Agregar plato" : "Editar plato";
				$("editPhoto").src = displayPhoto(d) || "";
				$("editPhoto").alt = d.name || "Foto del plato";
				$("fName").value = d.name;
				$("fDesc").value = d.desc || "";
				$("fCat").innerHTML = menu.categories.map((c) =>
					`<option value="${esc(c.id)}"${c.id === d.category ? " selected" : ""}>${esc(c.label)}</option>`
				).join("");
				$("optList").innerHTML = (d.options.length ? d.options : [{ label: "Sola", price: 0 }]).map(optRowHTML).join("");
				bindOptRows();
				$("deleteDishBtn").style.display = isNew ? "none" : "";
				$("saveDishBtn").textContent = isNew ? "Agregar plato" : "Guardar cambios";
				$("editOverlay").classList.add("open");
				$("fName").focus();
			}
			function bindOptRows() {
				$("optList").querySelectorAll(".opt-remove").forEach((b) =>
					b.addEventListener("click", () => {
						if ($("optList").children.length <= 1) { toast("El plato necesita al menos una opción.", true); return; }
						b.closest(".opt-row").remove();
					})
				);
			}
			function closeEdit() { $("editOverlay").classList.remove("open"); editingId = null; pendingUpload = null; }

			$("addOptBtn").addEventListener("click", () => {
				$("optList").insertAdjacentHTML("beforeend", optRowHTML({ label: "", price: 0 }));
				bindOptRows();
				const rows = $("optList").querySelectorAll(".opt-row");
				rows[rows.length - 1].querySelector(".opt-label").focus();
			});
			$("cancelEditBtn").addEventListener("click", closeEdit);
			$("editOverlay").addEventListener("click", (e) => { if (e.target === $("editOverlay")) closeEdit(); });
			$("deleteDishBtn").addEventListener("click", async () => {
				if (!editingId) return;
				const d = menu.dishes.find((x) => x.id === editingId);
				if (!d) return;
				if (!confirm(`¿Eliminar "${d.name}" del menú?`)) return;
				menu.dishes = menu.dishes.filter((x) => x.id !== editingId);
				closeEdit();
				await saveMenu(`Panel del Menú: eliminar "${d.name}"`);
			});

			$("editForm").addEventListener("submit", async (e) => {
				e.preventDefault();
				const name = $("fName").value.trim();
				if (!name) { toast("El plato necesita un nombre.", true); return; }
				const options = [...$("optList").querySelectorAll(".opt-row")].map((row) => ({
					label: row.querySelector(".opt-label").value.trim(),
					price: Math.max(0, Math.round(Number(row.querySelector(".opt-price").value) || 0)),
				})).filter((o) => o.label);
				if (!options.length) { toast("Agrega al menos una opción con precio.", true); return; }
				const isNew = !editingId;
				const id = isNew ? uniqueId(name) : editingId;
				const dish = {
					id,
					name,
					desc: $("fDesc").value.trim(),
					category: $("fCat").value,
					photo: editingPhoto,
					platePhoto: "",
					options,
				};
				// If the chosen photo is one of the black-plate shots, keep it as platePhoto.
				if (/black-plate/i.test(editingPhoto)) { dish.platePhoto = editingPhoto; dish.photo = ""; }
				if (isNew) menu.dishes.push(dish);
				else {
					const i = menu.dishes.findIndex((x) => x.id === id);
					if (i >= 0) menu.dishes[i] = dish;
				}
				closeEdit();
				renderGrid();
				await saveMenu(`Panel del Menú: ${isNew ? "agregar" : "actualizar"} "${name}"`);
			});
			function uniqueId(name) {
				let base = slugify(name), id = base, n = 2;
				while (menu.dishes.some((d) => d.id === id)) id = `${base}-${n++}`;
				return id;
			}

			// ---- photo picker ----
			function openPicker() {
				$("pickerGrid").innerHTML = photoList.map((f) =>
					`<button type="button" data-file="${esc(f)}" class="${f === editingPhoto ? "selected" : ""}" title="${esc(f)}">
						<img src="${esc(photoUrl(f))}" alt="${esc(f)}" loading="lazy" />
					</button>`
				).join("");
				$("pickerGrid").querySelectorAll("button").forEach((b) =>
					b.addEventListener("click", () => {
						editingPhoto = b.dataset.file;
						pendingUpload = null;
						$("editPhoto").src = photoUrl(editingPhoto);
						$("pickerOverlay").classList.remove("open");
					})
				);
				$("pickerOverlay").classList.add("open");
			}
			$("changePhotoBtn").addEventListener("click", openPicker);
			$("closePickerBtn").addEventListener("click", () => $("pickerOverlay").classList.remove("open"));
			$("pickerOverlay").addEventListener("click", (e) => { if (e.target === $("pickerOverlay")) $("pickerOverlay").classList.remove("open"); });
			$("uploadInput").addEventListener("change", async (e) => {
				const file = e.target.files && e.target.files[0];
				e.target.value = "";
				if (!file) return;
				if (!/\.(webp|jpe?g)$/i.test(file.name)) { toast("Solo se aceptan fotos .webp o .jpg.", true); return; }
				if (file.size > 4 * 1024 * 1024) { toast("La foto es muy grande (máx. 4 MB).", true); return; }
				const ext = file.name.toLowerCase().endsWith(".webp") ? "webp" : "jpg";
				const name = `${slugify(file.name.replace(/\.[^.]+$/, ""))}-${Date.now()}.${ext}`;
				const dataUrl = await new Promise((res, rej) => {
					const r = new FileReader();
					r.onload = () => res(r.result);
					r.onerror = rej;
					r.readAsDataURL(file);
				});
				pendingUpload = { file, name, dataUrl };
				editingPhoto = name;
				$("editPhoto").src = dataUrl;
				$("pickerOverlay").classList.remove("open");
				toast("Foto lista — se subirá al guardar.");
			});

			// ---- search / add ----
			$("searchInput").addEventListener("input", (e) => { query = e.target.value; renderGrid(); });
			$("addBtn").addEventListener("click", () => openEdit(null));

			// ---- auth (DecapBridge PKCE, same as Decap CMS) ----
			function b64url(bytes) {
				let s = "";
				bytes.forEach((b) => { s += String.fromCharCode(b); });
				return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
			}
			function randomString(len) {
				const chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-.";
				const arr = new Uint8Array(len);
				crypto.getRandomValues(arr);
				return [...arr].map((b) => chars[b % chars.length]).join("");
			}
			async function startLogin() {
				const verifier = randomString(128);
				const nonce = randomString(24);
				sessionStorage.setItem(VERIFIER_KEY, verifier);
				sessionStorage.setItem(NONCE_KEY, nonce);
				const challenge = b64url(new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier))));
				const url = new URL(`${AUTH_BASE}/sites/${SITE_ID}/pkce`);
				url.searchParams.set("client_id", "");
				url.searchParams.set("redirect_uri", location.origin + location.pathname);
				url.searchParams.set("response_type", "code");
				url.searchParams.set("state", JSON.stringify({ auth_type: "pkce", nonce }));
				url.searchParams.set("code_challenge_method", "S256");
				url.searchParams.set("code_challenge", challenge);
				location.assign(url.toString());
			}
			async function completeAuthIfNeeded() {
				const params = new URLSearchParams(location.search);
				const code = params.get("code");
				if (!code) return false;
				if (params.get("error")) { toast("No se pudo iniciar sesión: " + params.get("error"), true); return false; }
				const verifier = sessionStorage.getItem(VERIFIER_KEY);
				if (!verifier) { toast("Sesión de inicio expirada. Inténtalo de nuevo.", true); return false; }
				try {
					const res = await fetch(`${AUTH_BASE}/sites/${SITE_ID}/token`, {
						method: "POST",
						headers: { "Content-Type": "application/x-www-form-urlencoded" },
						body: new URLSearchParams({
							client_id: "",
							code,
							grant_type: "authorization_code",
							redirect_uri: location.origin + location.pathname,
							code_verifier: verifier,
						}).toString(),
					});
					const data = await res.json();
					if (!res.ok || !data.access_token) throw new Error(data.error_description || data.error || "token");
					token = data.access_token;
					localStorage.setItem(TOKEN_KEY, token);
					sessionStorage.removeItem(VERIFIER_KEY);
					sessionStorage.removeItem(NONCE_KEY);
					history.replaceState(null, "", location.pathname);
					toast("Sesión iniciada.");
					return true;
				} catch (err) {
					console.error(err);
					toast("No se pudo completar el inicio de sesión.", true);
					return false;
				}
			}
			function userLabel() {
				try {
					const payload = JSON.parse(atob(token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/")));
					return payload.first_name || payload.name || payload.email || "";
				} catch { return ""; }
			}
			// True only when the stored token exists and has not expired.
			function tokenValid() {
				if (!token) return false;
				try {
					const payload = JSON.parse(atob(token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/")));
					if (payload.exp && typeof payload.exp === "number") {
						return payload.exp * 1000 > Date.now();
					}
					return true;
				} catch { return false; }
			}
			function isLoggedIn() { return tokenValid(); }
			function refreshAuthUI() {
				const chip = $("userChip"), btn = $("loginBtn");
				const loggedIn = isLoggedIn();
				if (loggedIn) {
					const label = userLabel();
					chip.hidden = false;
					chip.textContent = label ? `Sesión: ${label}` : "Sesión iniciada";
					btn.textContent = "Cerrar sesión";
				} else {
					chip.hidden = true;
					btn.textContent = "Iniciar sesión";
				}
				// Login gate: nobody sees the dashboard without a valid login.
				$("loginGate").hidden = loggedIn;
				$("dashboard").hidden = !loggedIn;
			}
			// ---- account popover (person icon menu) ----
			function closeAccountPopover() {
				const pop = $("accountPopover");
				if (!pop || pop.hidden) return;
				pop.hidden = true;
				$("accountBtn").setAttribute("aria-expanded", "false");
			}
			$("accountBtn").addEventListener("click", (e) => {
				e.stopPropagation();
				const pop = $("accountPopover");
				const willOpen = pop.hidden;
				pop.hidden = !willOpen;
				$("accountBtn").setAttribute("aria-expanded", String(willOpen));
			});
			document.addEventListener("click", (e) => {
				if (!e.target.closest(".account-menu")) closeAccountPopover();
			});
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape") closeAccountPopover();
			});
			$("apVerSitio").addEventListener("click", closeAccountPopover);
			$("loginBtn").addEventListener("click", () => {
				if (token) {
					token = "";
					localStorage.removeItem(TOKEN_KEY);
					grid.innerHTML = "";
					pillsEl.innerHTML = "";
					refreshAuthUI();
					closeAccountPopover();
					toast("Sesión cerrada.");
				} else startLogin();
			});
			$("gateLoginBtn").addEventListener("click", startLogin);

			// ---- save (DecapBridge git-gateway = GitHub Contents API) ----
			function toBase64(str) {
				const bytes = new TextEncoder().encode(str);
				let bin = "";
				bytes.forEach((b) => { bin += String.fromCharCode(b); });
				return btoa(bin);
			}
			function base64OfDataUrl(dataUrl) {
				return dataUrl.split(",")[1] || "";
			}
			async function gw(path, opts) {
				const res = await fetch(`${GATEWAY}/repos/${REPO}/contents/${path}`, {
					...opts,
					headers: {
						Authorization: `Bearer ${token}`,
						Accept: "application/vnd.github+json",
						...(opts && opts.headers ? opts.headers : {}),
					},
				});
				return res;
			}
			async function saveMenu(message) {
				if (!token) {
					toast("Inicia sesión para guardar los cambios.", true);
					renderGrid();
					startLogin();
					return;
				}
				const saveBtn = $("saveDishBtn");
				try {
					// 1) Upload a new photo first, if one was chosen.
					if (pendingUpload) {
						const up = await gw(`${DISHES_DIR}/${pendingUpload.name}`, {
							method: "PUT",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({
								message: `Panel del Menú: subir foto ${pendingUpload.name}`,
								content: base64OfDataUrl(pendingUpload.dataUrl),
								branch: BRANCH,
							}),
						});
						if (!up.ok) throw new Error("No se pudo subir la foto (" + up.status + ")");
						pendingUpload = null;
					}
					// 2) Get the current SHA so we don't clash with other edits.
					const cur = await gw(`${MENU_PATH}?ref=${BRANCH}`, { method: "GET" });
					if (!cur.ok) throw new Error("No se pudo leer el menú actual (" + cur.status + ")");
					const curData = await cur.json();
					// 3) Write the updated menu.json.
					const json = JSON.stringify(menu, null, 2) + "\n";
					const put = await gw(MENU_PATH, {
						method: "PUT",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							message,
							content: toBase64(json),
							sha: curData.sha,
							branch: BRANCH,
						}),
					});
					if (!put.ok) {
						const err = await put.json().catch(() => ({}));
						throw new Error(err.message || ("No se pudo guardar (" + put.status + ")"));
					}
					toast("Guardado. El sitio se actualizará en unos minutos.");
				} catch (err) {
					console.error(err);
					toast("No se pudo guardar: " + err.message, true);
					// Offer a download so the work is never lost.
					const blob = new Blob([JSON.stringify(menu, null, 2)], { type: "application/json" });
					const a = document.createElement("a");
					a.href = URL.createObjectURL(blob);
					a.download = "menu.json";
					a.click();
					URL.revokeObjectURL(a.href);
					toast("Se descargó una copia de menu.json como respaldo.", true);
				} finally {
					renderGrid();
				}
			}

			// ---- theme (light / dark) ----
			const THEME_KEY = "lamovie-panel-theme";
			function currentTheme() {
				return document.documentElement.getAttribute("data-theme") || "light";
			}
			function applyTheme(theme, save) {
				document.documentElement.setAttribute("data-theme", theme);
				if (save !== false) {
					try { localStorage.setItem(THEME_KEY, theme); } catch (e) {}
				}
				const sw = $("themeSwitch");
				if (sw) sw.setAttribute("aria-checked", theme === "dark" ? "true" : "false");
			}
			$("themeSwitch").addEventListener("click", () => {
				applyTheme(currentTheme() === "dark" ? "light" : "dark");
			});
			// Follow the OS theme until the user picks one manually.
			try {
				if (!localStorage.getItem(THEME_KEY)) {
					const mq = window.matchMedia("(prefers-color-scheme: dark)");
					mq.addEventListener("change", (e) => applyTheme(e.matches ? "dark" : "light", false));
				}
			} catch (e) {}

			// ---- boot ----
			(async () => {
				applyTheme(currentTheme(), false);
				await completeAuthIfNeeded();
				// Drop an expired stored token so the login gate shows.
				if (token && !tokenValid()) {
					token = "";
					localStorage.removeItem(TOKEN_KEY);
				}
				refreshAuthUI();
				// Only render the menu once logged in — logged-out visitors
				// see just the login screen, never the dashboard.
				if (isLoggedIn()) {
					renderPills();
					renderGrid();
				}
			})();
		</script>
	</body>
</html>
