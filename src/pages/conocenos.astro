---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import OrderBar from "@components/OrderBar/OrderBar.astro";
import VisitInfo from "@components/VisitInfo/VisitInfo.astro";
import { Icon } from "astro-icon/components";
import { BUSINESS } from "@data/client";
import { dishImage } from "@data/menu";

const interiorPhoto = dishImage("interior-night.webp");
const frontPhoto = dishImage("storefront-night.webp");
---

<BaseLayout
	title="Conócenos — Cafetería La Movie"
	description="Cafetería La Movie en Los Mina, Katanga, Santo Domingo Este: comida dominicana hecha al momento. Chimis, mofongo, yaroa y plátanos — pide por WhatsApp."
>
	<section class="page-hero">
		<h1>Conóce<span class="rd">nos</span></h1>
		<p>
			La cafetería de la noche en Los Mina: comida dominicana hecha al momento, para
			compartir o para llevar.
		</p>
	</section>

	<!-- ============================================ -->
	<!--                  Historia                    -->
	<!-- ============================================ -->
	<section class="story">
		<Image
			src={interiorPhoto}
			alt="Interior de Cafetería La Movie"
			width={900}
			height={700}
			loading="eager"
			decoding="async"
			class="story-photo"
		/>
		<div class="story-text">
			<p class="sec-kicker">Nuestra historia</p>
			<h2 class="sec-title">La cocina <span class="hl">de la noche.</span></h2>
			<p>
				Cafetería La Movie es la cafetería de la noche en Los Mina, Katanga, Santo
				Domingo Este. Abrimos cuando cae el sol y cocinamos al momento: chimis de
				pierna, mofongo, yaroa, patacón, burritos y plátanos fritos, con el sabor de
				la calle dominicana.
			</p>
			<p>
				Todo se pide por WhatsApp. Lo recoges en el local o te lo llevamos a la
				puerta. Sin complicaciones: pides, lo preparamos y listo.
			</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!--                  Valores                     -->
	<!-- ============================================ -->
	<section class="values">
		<article class="value">
			<Icon name="fa6-solid:fire-flame-curved" aria-hidden="true" />
			<h3>Hecho al momento</h3>
			<p>Nada precocido. Cada plato se prepara cuando lo pides.</p>
		</article>
		<article class="value">
			<Icon name="fa6-solid:moon" aria-hidden="true" />
			<h3>Abierto tarde</h3>
			<p>Miércoles a domingo, de 6:45 PM a 12:00 AM.</p>
		</article>
		<article class="value">
			<Icon name="fa6-solid:motorcycle" aria-hidden="true" />
			<h3>Recoger o delivery</h3>
			<p>Recógelo caliente en el local o te lo llevamos a la puerta.</p>
		</article>
	</section>

	<!-- ============================================ -->
	<!--                   El local                   -->
	<!-- ============================================ -->
	<section class="place">
		<div class="place-text">
			<p class="sec-kicker">Nuestro local</p>
			<h2 class="font-display">Te esperamos en Los Mina</h2>
			<p class="place-info">
				{BUSINESS.address.lineOne} {BUSINESS.address.lineTwo} {BUSINESS.address.lineThree} · {BUSINESS.hours.short}
			</p>
		</div>
		<div class="place-photo-wrap">
			<Image
				src={frontPhoto}
				alt="Frente de Cafetería La Movie de noche"
				width={1600}
				height={800}
				loading="lazy"
				decoding="async"
				class="place-photo"
			/>
		</div>
	</section>

	<section class="about-blocks">
		<div class="about-block">
			<h2 class="font-display">Lo que servimos</h2>
			<p>
				Chimis de pierna, mofongo con longaniza o camarones, yaroa de pollo o res,
				patacón, burritos, chuletas y pechuga a la plancha, alitas, salchipapas y más.
				Todo con plátanos, papas y fritos de la casa.
			</p>
		</div>
		<div class="about-block">
			<h2 class="font-display">Cómo se pide</h2>
			<p>
				Arma tu pedido en el menú y envíalo por WhatsApp, o escríbenos directo al
				{BUSINESS.phoneFormatted}. Dinos si lo recoges o si te lo llevamos.
			</p>
			<a href={BUSINESS.whatsapp} target="_blank" rel="noopener" class="cs-button-solid">
				Pedir por WhatsApp
			</a>
		</div>
		<div class="about-block">
			<h2 class="font-display">Cuándo estamos</h2>
			<p>
				{BUSINESS.hours.open}
				<br />
				{BUSINESS.hours.closed}
			</p>
		</div>
	</section>

	<VisitInfo />

	<!-- ============================================ -->
	<!--                 Llamado                      -->
	<!-- ============================================ -->
	<section class="cta">
		<p class="sec-kicker">Pide ahora</p>
		<h2 class="sec-title">¿Tienes <span class="hl">antojo?</span></h2>
		<p>Escríbenos por WhatsApp y lo preparamos al momento.</p>
		<div class="cta-actions">
			<a href={BUSINESS.whatsapp} target="_blank" rel="noopener" class="cs-button-solid">
				Pedir por WhatsApp
			</a>
			<a href="/menu/" class="cs-button-transparent">Ver menú</a>
		</div>
	</section>

	<OrderBar />
</BaseLayout>

<style lang="less">
	.story {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
		display: grid;
		grid-template-columns: 1fr;
		gap: (24/16rem);
		align-items: center;
	}

	.story-photo {
		width: 100%;
		height: auto;
		border-radius: (20/16rem);
		display: block;
	}

	.story-text {
		.sec-title {
			margin-bottom: (16/16rem);
		}

		p {
			font-size: (16/16rem);
			line-height: 1.7em;
			color: #d4d4d4;
			margin-bottom: (16/16rem);

			&:last-child {
				margin-bottom: 0;
			}
		}
	}

	@media only screen and (min-width: 64rem) {
		.story {
			grid-template-columns: 1fr 1fr;
			gap: (48/16rem);
		}
	}

	.values {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
		display: grid;
		grid-template-columns: 1fr;
		gap: (16/16rem);
	}

	.value {
		text-align: center;
		background-color: #141414;
		border: 1px solid #232323;
		border-radius: (20/16rem);
		padding: (32/16rem) (24/16rem);

		svg {
			width: (40/16rem);
			height: (40/16rem);
			color: var(--secondary);
			margin-bottom: (16/16rem);
		}

		h3 {
			font-size: (22/16rem);
			color: #fff;
			margin-bottom: (8/16rem);
		}

		p {
			font-size: (15/16rem);
			color: #a8a8a8;
			margin-bottom: 0;
		}
	}

	@media only screen and (min-width: 64rem) {
		.values {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.place {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
	}

	.place-text {
		text-align: left;
		margin-bottom: (28/16rem);

		.sec-kicker {
			margin-bottom: (6/16rem);
		}

		h2 {
			font-size: clamp(1.7rem, 4.5cqw, 2.6rem);
			line-height: 1em;
			text-transform: uppercase;
			color: #fff;
			margin: 0 0 (8/16rem);
		}
	}

	.place-photo-wrap {
		position: relative;
		border-radius: (20/16rem);
		overflow: hidden;
	}

	.place-photo {
		width: 100%;
		height: clamp(240px, 45vw, 520px);
		object-fit: cover;
		display: block;
	}

	.place-info {
		font-size: (15/16rem);
		font-weight: 700;
		line-height: 1.5em;
		color: #e8e0d0;
		margin: 0;
	}

	.about-blocks {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
		display: grid;
		grid-template-columns: 1fr;
		gap: (24/16rem);
	}

	.about-block {
		border-top: 2px solid #232323;
		padding-top: (24/16rem);
		display: flex;
		flex-direction: column;
		align-items: flex-start;

		h2 {
			font-size: (24/16rem);
			color: #fff;
			margin-bottom: (12/16rem);
		}

		p {
			font-size: (16/16rem);
			line-height: 1.7em;
			color: #d4d4d4;
			margin-bottom: (16/16rem);
		}

		// the button sits at the bottom of every block, so all three
		// blocks end on the same line even when their texts differ
		.cs-button-solid {
			margin-top: auto;
		}
	}

	@media only screen and (min-width: 64rem) {
		.about-blocks {
			grid-template-columns: repeat(3, 1fr);
			gap: (32/16rem);
		}
	}

	.cta {
		max-width: (1280/16rem);
		margin: auto;
		padding: var(--sectionPadding);
		text-align: center;

		.sec-title {
			margin-bottom: (12/16rem);
		}

		p {
			font-size: (17/16rem);
			line-height: 1.6em;
			color: #cfc8b8;
			margin-bottom: (28/16rem);
		}
	}

	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: (12/16rem);
	}
</style>
