---
import BaseLayout from "@layouts/BaseLayout.astro";
import DishCard from "@components/DishCard/DishCard.astro";
import OrderBar from "@components/OrderBar/OrderBar.astro";
import AlsoHave from "@components/AlsoHave/AlsoHave.astro";
import { CATEGORIES, DISHES } from "@data/menu";
---

<BaseLayout
	title="Menú — Cafetería La Movie"
	description="Menú completo de Cafetería La Movie: hamburguesas, mofongo, platos a la plancha, yaroa, patacón, chimi, sándwiches, tostadas y más. Arma tu pedido y envíalo por WhatsApp."
>
	<section class="page-hero">
		<h1>El <span class="stroke">menú</span></h1>
		<p>
			Elige tu plato, escoge la opción y agrégalo a tu pedido. Al final, lo envías por
			WhatsApp y lo preparamos al momento.
		</p>
	</section>

	<div class="filters" data-filters role="group" aria-label="Filtrar por categoría">
		<button type="button" class="filter-pill is-active" data-filter="todos" aria-pressed="true">
			Todos
		</button>
		{
			CATEGORIES.map((cat) => (
				<button type="button" class="filter-pill" data-filter={cat.id} aria-pressed="false">
					{cat.label}
				</button>
			))
		}
	</div>

	{
		CATEGORIES.map((cat, i) => {
			const dishes = DISHES.filter((d) => d.category === cat.id);
			return (
				<section class="menu-category" data-category-section={cat.id} id={cat.id}>
					<h2 class="font-display">
						<span class="n">{String(i + 1).padStart(2, "0")}</span>
						{cat.label}
					</h2>
					<div class="menu-grid">
						{dishes.map((dish) => (
							<DishCard dish={dish} mode="menu" />
						))}
					</div>
				</section>
			);
		})
	}

	<AlsoHave />
	<OrderBar />
</BaseLayout>

<style lang="less">
	.menu-category {
		max-width: (1280/16rem);
		margin: auto;
		padding: (40/16rem) (16/16rem) (16/16rem);

		// proposal .menu-section h2: Lilita One uppercase with a red number
		h2 {
			font-size: clamp(1.8rem, 5cqw, 2.7rem);
			text-transform: uppercase;
			line-height: 1em;
			color: #f5efe6;
			margin-bottom: (8/16rem);

			.n {
				color: var(--primary);
				margin-right: 0.18em;
			}
		}
	}

	.filters {
		max-width: (1280/16rem);
		margin: auto;
		padding: (32/16rem) (16/16rem) (8/16rem);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: (10/16rem);
		position: sticky;
		top: (72/16rem);
		z-index: 100;
		background-color: rgba(0, 0, 0, 0.9);
		backdrop-filter: blur(8px);
	}

	.filter-pill {
		font-family: var(--font-primary);
		font-size: (15.2/16rem);
		font-weight: 900;
		line-height: 1.2em;
		color: #f5efe6;
		background-color: #0b120c;
		border: 2px solid #22301f;
		border-radius: 999px;
		padding: (10/16rem) (20/16rem);
		min-height: (46/16rem);
		cursor: pointer;
		transition:
			background-color 0.3s,
			color 0.3s,
			border-color 0.3s;

		&:hover {
			border-color: var(--secondary);
		}

		&.is-active {
			color: #141414;
			background-color: var(--secondary);
			border-color: var(--secondary);
		}
	}

	.menu-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: (24/16rem);
	}

	@media only screen and (min-width: 45rem) {
		.menu-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media only screen and (min-width: 64rem) {
		.filters {
			top: (76/16rem);
		}

		.menu-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
