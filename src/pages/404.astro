---
import BaseLayout from "@layouts/BaseLayout.astro";

import { getSiteContext } from "@js/getSiteContext";
import { getLocalizedRoute } from "@js/routes";

const { locale, content } = await getSiteContext(Astro.url);
const title = content.common.notFound.pageNotFound;
---

<BaseLayout title={title} description={title}>
	<section id="int-hero">
		<p class="cs-topper">Cafetería La Movie</p>
		<h1 class="font-display">{title}</h1>
		<p>Puede que el plato que buscas ya se acabó… o que el enlace cambió.</p>
		<a href={getLocalizedRoute(locale, "/")} class="cs-button-solid">
			{content.common.notFound.linkText}
		</a>
	</section>
</BaseLayout>

<style lang="less">
	#int-hero {
		min-height: 70dvh;
		padding: (80/16rem) (16/16rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;

		h1 {
			font-size: clamp(2rem, 6vw, 3.5rem);
			line-height: 1.15em;
			color: #fff;
			max-width: (720/16rem);
			margin-bottom: (16/16rem);
		}

		p:not(.cs-topper) {
			font-size: (17/16rem);
			color: #d4d4d4;
			margin-bottom: (32/16rem);
		}
	}
</style>
